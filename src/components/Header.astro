---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { name: 'Home', href: '/', id: 'home' },
  { name: 'Advaita Vedānta', href: '/advaita-vedanta', id: 'advaita' },
  { name: 'Itihāsas', href: '/itihasas', id: 'itihasas' },
  { name: 'Purāṇas', href: '/puranas', id: 'puranas' },
  { name: 'Yoga', href: '/yoga', id: 'yoga' },
  { name: 'Lexicon', href: '/bhashya-dictionary', id: 'dict' },
  { name: 'Library', href: '/scriptures', id: 'scriptures' },
];
---

<header class="site-header" id="mainHeader">
  <div class="container">
    <div class="header-inner">
      <!-- Brand Link -->
      <a href="/" class="brand-link" aria-label="VedāntVāṇī Home">
        <img src="/assets/sacred_lotus_gold.png" alt="Sacred Lotus" class="brand-logo" width="36" height="36" />
        <div class="brand-text-container">
          <span class="brand-title">VedāntVāṇī</span>
          <span class="brand-subtitle font-cinzel">वेदान्त वाणी • Sacred Wisdom</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="desktop-nav" aria-label="Main Navigation">
        {navLinks.map((link) => {
          const isActive = link.href === '/' 
            ? currentPath === '/' 
            : currentPath.startsWith(link.href);

          if (link.id === 'itihasas') {
            return (
              <div class="nav-dropdown-item-group">
                <a 
                  href={link.href} 
                  class={`nav-item nav-item-has-sub ${isActive ? 'active' : ''}`}
                >
                  <span>{link.name}</span>
                  <span class="nav-caret">▾</span>
                </a>
                <div class="nav-sub-menu">
                  <a href="/adhyatma-ramayana" class="sub-menu-link">
                    <span class="sub-icon">🏹</span>
                    <div class="sub-info">
                      <strong class="font-cinzel">Adhyātma Rāmāyaṇa</strong>
                      <small>Advaita Puranic Epic • 7 Kāṇḍas</small>
                    </div>
                  </a>
                  <a href="/read/bhagavad-gita" class="sub-menu-link">
                    <span class="sub-icon">⚔️</span>
                    <div class="sub-info">
                      <strong class="font-cinzel">Bhagavad Gītā</strong>
                      <small>Mahābhārata • 18 Chapters</small>
                    </div>
                  </a>
                  <div class="sub-divider"></div>
                  <a href="/itihasas" class="sub-menu-link sub-all font-cinzel">
                    <span>Explore Itihāsas Portal →</span>
                  </a>
                </div>
              </div>
            );
          }

          return (
            <a 
              href={link.href} 
              class={`nav-item ${isActive ? 'active' : ''}`}
            >
              {link.name}
            </a>
          );
        })}
      </nav>

      <!-- Header Actions: Search & Theme Toggle -->
      <div class="header-actions">
        <button 
          id="searchTriggerBtn" 
          class="search-trigger-pill" 
          aria-label="Open Scripture Search"
        >
          <span>🔍</span>
          <span class="search-text-label" style="display: none;">Search...</span>
          <kbd>/</kbd>
        </button>

        <button 
          id="themeToggleBtn" 
          class="action-btn" 
          aria-label="Toggle Light/Dark Theme"
          title="Toggle Theme"
        >
          <span id="themeIcon">☀️</span>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  @media (min-width: 640px) {
    .search-text-label {
      display: inline !important;
    }
  }

  /* Navigation Dropdown */
  .nav-dropdown-item-group {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .nav-item-has-sub {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
  }

  .nav-caret {
    font-size: 0.65rem;
    transition: transform var(--transition-fast);
  }

  .nav-dropdown-item-group:hover .nav-caret {
    transform: rotate(180deg);
  }

  .nav-sub-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    background: var(--bg-surface-elevated, #11141c);
    border: 1px solid var(--border-active, rgba(242, 111, 34, 0.35));
    border-radius: var(--radius-md);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6), 0 0 20px rgba(242, 111, 34, 0.08);
    min-width: 250px;
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    z-index: 100;
  }

  .nav-dropdown-item-group:hover .nav-sub-menu,
  .nav-dropdown-item-group:focus-within .nav-sub-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }

  .sub-menu-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--text-primary);
    transition: background var(--transition-fast);
  }

  .sub-menu-link:hover {
    background: var(--saffron-subtle, rgba(242, 111, 34, 0.12));
  }

  .sub-icon {
    font-size: 1.25rem;
  }

  .sub-info {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .sub-info strong {
    font-size: 0.85rem;
    color: var(--gold, #d4af37);
  }

  .sub-info small {
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .sub-divider {
    height: 1px;
    background: var(--border-subtle);
    margin: 0.2rem 0;
  }

  .sub-all {
    font-size: 0.78rem;
    color: var(--saffron);
    justify-content: center;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>

<script is:inline>
  (function() {
    const savedTheme = localStorage.getItem('vv_theme') || 'dark';
    if (savedTheme === 'light') {
      document.body.classList.add('light-theme');
      updateThemeIcon(true);
    } else {
      document.body.classList.remove('light-theme');
      updateThemeIcon(false);
    }

    function updateThemeIcon(isLight) {
      const icon = document.getElementById('themeIcon');
      if (icon) icon.textContent = isLight ? '🌙' : '☀️';
    }

    const toggleBtn = document.getElementById('themeToggleBtn');
    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        const isLight = document.body.classList.toggle('light-theme');
        localStorage.setItem('vv_theme', isLight ? 'light' : 'dark');
        updateThemeIcon(isLight);
      });
    }

    // Keyboard shortcut '/' to search
    window.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
        e.preventDefault();
        window.dispatchEvent(new CustomEvent('open-search-modal'));
      }
    });

    const searchBtn = document.getElementById('searchTriggerBtn');
    if (searchBtn) {
      searchBtn.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('open-search-modal'));
      });
    }
  })();
</script>
