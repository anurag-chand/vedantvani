  function openFlaggedDrawer() {
    const d = document.getElementById('flaggedDrawer');
    if (d) {
      d.classList.add('open');
      d.setAttribute('aria-hidden', 'false');
      renderFlaggedVersesList();
    }
  }

  function closeFlaggedDrawer() {
    const d = document.getElementById('flaggedDrawer');
    if (d) {
      d.classList.remove('open');
      d.setAttribute('aria-hidden', 'true');
    }
  }

  function renderFlaggedVersesList() {
    const container = document.getElementById('flaggedVersesList');
    if (!container) return;

    const keys = Object.keys(flaggedVerses);
    if (keys.length === 0) {
      container.innerHTML = `
        <div class="empty-flags-box font-lora">
          <span style="font-size: 2.5rem;">🚩</span>
          <h4 class="font-serif">No Flagged Verses Yet</h4>
          <p>Tap the <strong>🚩 Flag for Review</strong> button on any verse card to bookmark it here for personal study or translation refinement.</p>
        </div>
      `;
      return;
    }

    container.innerHTML = keys.map(k => {
      const item = flaggedVerses[k];
      const parts = k.split('_');
      const kNum = parts[0];
      const sNum = parts[1];
      const vNum = parts[2];
      const kNames = ['', 'Bālakāṇḍa', 'Ayodhyākāṇḍa', 'Āraṇyakāṇḍa', 'Kiṣkindhākāṇḍa', 'Sundarakāṇḍa', 'Yuddhakāṇḍa', 'Uttarakāṇḍa'];
      const dateStr = item.timestamp ? new Date(item.timestamp).toLocaleDateString() : '';

      return `
        <div class="flagged-verse-item">
          <div class="fvi-header font-sans">
            <span class="fvi-coord">${kNames[parseInt(kNum, 10)]} • Sarga ${sNum} • Verse ${vNum}</span>
            <span class="fvi-date font-sans">${dateStr}</span>
          </div>
          <div class="fvi-note font-lora">
            <strong>Note:</strong> ${item.note || 'Marked for review'}
          </div>
          <div class="fvi-actions">
            <button class="fvi-jump-btn font-sans" data-k="${kNum}" data-s="${sNum}" data-v="${vNum}">Jump to Verse →</button>
            <button class="fvi-remove-btn" data-key="${k}" title="Remove flag">✕</button>
          </div>
        </div>
      `;
    }).join('');

    container.querySelectorAll('.fvi-jump-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const k = parseInt(btn.getAttribute('data-k') || '1', 10);
        const s = parseInt(btn.getAttribute('data-s') || '1', 10);
        const v = parseInt(btn.getAttribute('data-v') || '1', 10);
        closeFlaggedDrawer();
        
        await loadKanda(k, s);
        // Find which event contains verse v
        if (currentKandaData) {
          const sarga = currentKandaData.sargas.find(sg => sg.sarga_number === s);
          if (sarga) {
            const ev = sarga.events.find(e => e.start_verse <= v && v <= e.end_verse);
            if (ev) selectEvent(ev.segment_id);
          }
        }
      });
    });

    container.querySelectorAll('.fvi-remove-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const k = btn.getAttribute('data-key');
        if (k) {
          delete flaggedVerses[k];
          saveFlags();
          renderFlaggedVersesList();
          // Update current card if visible
          const card = document.getElementById(`verseCard_${k}`);
          if (card) {
            card.classList.remove('verse-flagged');
            card.querySelector('.flag-toggle-btn')?.classList.remove('active');
            document.getElementById(`flagBanner_${k}`)?.classList.remove('show');
          }
        }
      });
    });
  }

  function openOntologyModal(refId) {
    const modal = document.getElementById('ontologyModal');
    const termEl = document.getElementById('ontologyModalTerm');
    const refEl = document.getElementById('ontologyModalRefId');
    const bodyEl = document.getElementById('ontologyModalBody');

    const ont = ontologyData ? ontologyData[refId] : null;
    const term = ont ? ont.term : refId.replace('ADV-CAND-', '').replace(/_/g, ' ');
    const def = ont ? ont.definition : 'Advaita metaphysical category reflecting non-dual reality, unconditioned awareness, or the play of cosmic Maya.';

    if (termEl) termEl.textContent = term;
    if (refEl) refEl.textContent = 'Advaita Vedānta Principle';
    if (bodyEl) {
      bodyEl.innerHTML = `
        <div class="ontology-def-card">
          <h4>Philosophical Definition in Advaita Vedānta</h4>
          <p>${def}</p>
        </div>
      `;
    }

    if (modal) {
      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');
    }
  }

  function closeOntologyModal() {
    const modal = document.getElementById('ontologyModal');
    if (modal) {
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
    }
  }

  // Dictionary Drawer Integration
  function openDictionaryWithWord(word) {
    const drawer = document.getElementById('onScreenDictDrawer');
    const input = document.getElementById('onScreenDictInput') as HTMLInputElement;
    if (drawer) {
      drawer.classList.add('open');
      drawer.setAttribute('aria-hidden', 'false');
    }
    if (input) {
      input.value = word;
      performDictLookup(word);
    }
  }

  function closeDictionary() {
    const drawer = document.getElementById('onScreenDictDrawer');
    if (drawer) {
      drawer.classList.remove('open');
      drawer.setAttribute('aria-hidden', 'true');
    }
  }

  async function performDictLookup(term) {
    const cleanWord = (term || '').trim();
    if (!cleanWord) return;

    const devaWord = toDevanagari(cleanWord);
    const activeCard = document.getElementById('dictActiveEntryCard');
    const emptyState = document.getElementById('dictEmptyState');

    if (activeCard) {
      activeCard.style.display = 'block';
      activeCard.innerHTML = `
        <div class="dict-loading-wrap">
          <div class="dict-spinner"></div>
          <p class="font-lora">Querying lexicon for "${devaWord}"...</p>
        </div>
      `;
    }
    if (emptyState) emptyState.style.display = 'none';

    try {
      const workerUrl = 'https://vedantvani-dict-worker.anuragchand88.workers.dev';
      const res = await fetch(`${workerUrl}/api/dict/word?term=${encodeURIComponent(devaWord)}&scope=all`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();

      if (data && data.success && data.result) {
        renderDictEntry(data.result);
      } else {
        renderDictNotFound(devaWord);
      }
    } catch (err) {
      renderDictNotFound(devaWord);
    }
  }

  function renderDictEntry(entry) {
    const card = document.getElementById('dictActiveEntryCard');
    if (!card) return;

    card.style.display = 'block';
    card.innerHTML = `
      <div class="dict-card-surface-row">
        <span class="dict-card-surface font-devanagari">${entry.surface}</span>
        <span class="dict-card-source-tag font-sans">${entry.source === 'bhasya' ? 'Śāṅkara Bhāṣya' : 'Mūla Lexicon'}</span>
      </div>
      ${entry.padaccheda ? `<div class="dict-card-padaccheda font-devanagari"><strong>Padaccheda:</strong> ${entry.padaccheda}</div>` : ''}
      ${entry.grammar ? `<div class="dict-card-grammar font-sans">${entry.grammar}</div>` : ''}
      <div class="dict-card-meaning font-lora">${entry.meaning_en || 'Meaning indexed in lexicon.'}</div>
    `;
  }

  function renderDictNotFound(term) {
    const card = document.getElementById('dictActiveEntryCard');
    if (!card) return;
    card.style.display = 'block';
    card.innerHTML = `
      <div class="dict-not-found">
        <h4>No exact definition found for "${term}"</h4>
        <p class="font-lora">Try searching the root form or check transliteration.</p>
      </div>
    `;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

