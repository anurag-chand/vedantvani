      <div class="highlight-item-card" data-kanda="${h.kanda}" data-sarga="${h.sarga}" data-event="${h.segment_id}">
        <div class="h-top">
          <span class="h-kanda-pill font-sans">${h.kanda_name} • Sarga ${h.sarga}</span>
