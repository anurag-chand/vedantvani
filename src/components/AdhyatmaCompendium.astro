---
interface Props {
  initialKanda?: number;
  initialSarga?: number;
  initialEventId?: string;
}

const { initialKanda = 1, initialSarga = 1, initialEventId = 'AR-BAL-01-01' } = Astro.props;
---

<div class="adhyatma-root" id="adhyatmaCompendiumApp" data-initial-kanda={initialKanda} data-initial-sarga={initialSarga} data-initial-event={initialEventId}>
  <!-- Top App Bar -->
  <header class="compendium-topbar">
    <div class="topbar-left">
      <a href="/itihasas" class="topbar-back-btn" title="Back to Itihāsas">
        <span>←</span>
      </a>
      <div class="topbar-titles">
        <h1 class="compendium-title font-devanagari">अध्यात्मरामायणम्</h1>
        <span class="compendium-tagline font-lora">Adhyātma Rāmāyaṇa • Non-Dual Compendium</span>
      </div>
    </div>

    <div class="topbar-center">
      <!-- Quick Navigation Selectors -->
      <div class="nav-selector-pill">
        <select id="kandaSelect" class="nav-select font-sans" aria-label="Select Kāṇḍa">
          <option value="1">1. Bālakāṇḍa (बालकाण्डम्)</option>
          <option value="2">2. Ayodhyākāṇḍa (अयोध्याकाण्डम्)</option>
          <option value="3">3. Āraṇyakāṇḍa (अरण्यकाण्डम्)</option>
          <option value="4">4. Kiṣkindhākāṇḍa (किष्किन्धाकाण्डम्)</option>
          <option value="5">5. Sundarakāṇḍa (सुन्दरकाण्डम्)</option>
          <option value="6">6. Yuddhakāṇḍa (युद्धकाण्डम्)</option>
          <option value="7">7. Uttarakāṇḍa (उत्तरकाण्डम्)</option>
        </select>
        <span class="select-sep">•</span>
        <select id="sargaSelect" class="nav-select font-sans" aria-label="Select Sarga">
          <option value="1">Sarga 1</option>
        </select>
      </div>
    </div>

    <div class="topbar-right">
      <!-- Flagged Verses Review Badge Button -->
      <button id="openFlaggedDrawerBtn" class="topbar-btn flag-btn-highlight font-sans" title="Review Flagged Verses">
        <span>🚩</span>
        <span class="flagged-count-label" id="topbarFlagCount">0 Flagged</span>
      </button>

      <!-- Key Teachings Menu -->
      <button id="openHighlightsBtn" class="topbar-btn font-sans" title="Key Advaita Teachings (Rāma Gītā, Rāma Hṛdaya, etc.)">
        <span>⭐</span>
        <span class="btn-text-desktop">Key Teachings</span>
      </button>

      <!-- Dictionary Lookup Trigger -->
      <button id="openDictBtn" class="topbar-btn dict-btn font-sans" title="On-Screen Dictionary Lookup">
        <span>📖</span>
        <span class="btn-text-desktop">Lexicon</span>
      </button>

      <!-- Event Drawer Toggle -->
      <button id="openEventDrawerBtn" class="topbar-btn primary font-sans" title="Browse Sarga Episodes">
        <span>📑</span>
        <span>Episodes</span>
      </button>
    </div>
  </header>

  <!-- Main Compendium Workspace -->
  <div class="compendium-workspace">
    
    <!-- Left Navigation Rail / Event Timeline (Desktop) -->
    <aside class="event-rail" id="desktopEventRail">
      <div class="rail-header">
        <span class="rail-kanda-badge font-sans" id="railKandaLabel">Bālakāṇḍa</span>
        <h3 class="rail-sarga-title font-devanagari" id="railSargaTitle">प्रथमः सर्गः • रामहृदयम्</h3>
        <span class="rail-event-count font-sans" id="railEventCount">Loading episodes...</span>
      </div>

      <div class="rail-events-list" id="railEventsContainer">
        <!-- Event item cards dynamically injected -->
      </div>
    </aside>

    <!-- Main Content Stream Area -->
    <main class="compendium-stream" id="mainStreamArea">
      
      <!-- Event Master Header Card -->
      <section class="event-hero-card" id="activeEventCard">
        <div class="event-header-meta">
          <div class="event-id-group">
            <span class="event-episode-pill font-sans" id="heroEventId">Episode 1</span>
            <span class="event-type-pill font-sans" id="heroEventType">Cosmic Revelation</span>
            <span class="event-range-pill font-sans" id="heroVerseRange">Verses 1 to 5</span>
          </div>

          <div class="event-nav-quick">
            <button id="prevEventBtn" class="icon-nav-btn font-sans" title="Previous Episode (←)">◀ Prev</button>
            <button id="nextEventBtn" class="icon-nav-btn font-sans" title="Next Episode (→)">Next ▶</button>
          </div>
        </div>

        <h2 class="event-title font-serif" id="heroEventTitle">Loading Episode...</h2>
        
        <p class="event-summary font-lora" id="heroEventSummary">
          Loading narrative summary and non-dual exposition...
        </p>

        <!-- Deep Philosophical & Contextual Metadata Grid -->
        <div class="event-metadata-grid" id="heroMetaGrid">
          
          <!-- Philosophy Density & Concepts -->
          <div class="meta-card">
            <div class="meta-card-label font-sans">
              <span>🧠</span> Advaita Philosophy & Teachings
            </div>
            <div class="meta-card-body" id="heroOntologyPills">
              <!-- Concepts injected -->
            </div>
          </div>

          <!-- Characters & Cosmic Principles -->
          <div class="meta-card">
            <div class="meta-card-label font-sans">
              <span>🎭</span> Featured Divine Personalities
            </div>
            <div class="meta-card-body" id="heroCharactersPills">
              <!-- Characters injected -->
            </div>
          </div>

          <!-- Locus, Symbolic Meaning & Dialogue Frame -->
          <div class="meta-card meta-card-wide">
            <div class="meta-card-label font-sans">
              <span>📍</span> Sacred Setting & Dialogue Frame
            </div>
            <div class="meta-card-body-horizontal font-lora" id="heroContextStrip">
              <!-- Setting info injected -->
            </div>
          </div>

        </div>
      </section>

      <!-- Verses Header Strip -->
      <div class="verses-strip-header">
        <div class="strip-left font-sans">
          <span>📜</span> Sacred Shlokas in this Episode (<span id="eventVerseTotal">0</span> Verses)
        </div>
        <div class="strip-right font-lora">
          <span class="hint-text">💡 Tap any Sanskrit word for definition & grammar</span>
        </div>
      </div>

      <!-- Verses List Container -->
      <div class="verses-stream" id="versesContainer">
        <!-- Verse cards dynamically injected -->
      </div>

      <!-- Bottom Event Pager -->
      <div class="event-footer-pager">
        <button id="footerPrevBtn" class="pager-btn font-sans">
          <span>← Previous Episode</span>
          <span class="pager-sub" id="footerPrevLabel">Previous Episode</span>
        </button>
        <button id="footerNextBtn" class="pager-btn font-sans">
          <span>Next Episode →</span>
          <span class="pager-sub" id="footerNextLabel">Next Episode</span>
        </button>
      </div>

    </main>
  </div>

  <!-- Mobile Event Selector Drawer / Bottom Sheet -->
  <div class="compendium-drawer-backdrop" id="eventDrawerBackdrop" aria-hidden="true">
    <div class="compendium-drawer-panel">
      <div class="drawer-header">
        <h3 class="font-serif">Episodes in <span id="drawerSargaLabel">Current Sarga</span></h3>
        <button id="closeDrawerBtn" class="drawer-close-btn font-sans" aria-label="Close Drawer">✕</button>
      </div>
      <div class="drawer-content" id="drawerEventsContainer">
        <!-- Events injected -->
      </div>
    </div>
  </div>

  <!-- High-Density Key Teachings Modal -->
  <div class="compendium-modal-backdrop" id="highlightsModal" aria-hidden="true">
    <div class="compendium-modal-panel">
      <div class="modal-header">
        <div class="modal-title-group">
          <span class="modal-icon">⭐</span>
          <div>
            <h3 class="font-serif">Crown Jewels of Adhyātma Rāmāyaṇa</h3>
            <p class="font-lora">Celebrated philosophical hymns, dialogues, and Advaita revelations.</p>
          </div>
        </div>
        <button id="closeHighlightsBtn" class="drawer-close-btn font-sans" aria-label="Close">✕</button>
      </div>

      <div class="modal-body" id="highlightsList">
        <!-- Highlight cards injected -->
      </div>
    </div>
  </div>

  <!-- Flagged Verses Review Drawer -->
  <div class="compendium-drawer-backdrop" id="flaggedDrawer" aria-hidden="true">
    <div class="compendium-drawer-panel">
      <div class="drawer-header">
        <div>
          <h3 class="font-serif">🚩 Flagged Verses for Personal Review</h3>
          <p class="font-lora" style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.2rem;">
            Verses marked by you for re-reading, translation review, or re-generation.
          </p>
        </div>
        <div class="drawer-header-actions">
          <button id="clearAllFlagsBtn" class="text-action-btn font-sans" title="Clear all saved flags">Clear All</button>
          <button id="closeFlaggedDrawerBtn" class="drawer-close-btn font-sans" aria-label="Close">✕</button>
        </div>
      </div>
      <div class="drawer-content" id="flaggedVersesList">
        <p class="font-lora" style="padding: 2rem; text-align: center; color: var(--text-muted);">
          No verses flagged yet. While reading, click the 🚩 Flag for Review button on any verse to save it here.
        </p>
      </div>
    </div>
  </div>

  <!-- Advaita Ontology Definition Modal -->
  <div class="compendium-modal-backdrop" id="ontologyModal" aria-hidden="true">
    <div class="compendium-modal-panel ontology-modal-panel">
      <div class="modal-header">
        <div class="modal-title-group">
          <span class="modal-icon">🕉️</span>
          <div>
            <h3 class="font-serif" id="ontologyModalTerm">Advaita Vedānta Concept</h3>
            <p class="font-sans" id="ontologyModalRefId" style="font-size: 0.82rem; color: var(--comp-gold); margin-top: 0.15rem;">Non-Dual Principle</p>
          </div>
        </div>
        <button id="closeOntologyModalBtn" class="drawer-close-btn font-sans" aria-label="Close">✕</button>
      </div>
      <div class="modal-body font-lora" id="ontologyModalBody">
        Loading concept definition...
      </div>
    </div>
  </div>

  <!-- On-Screen Dictionary Drawer (132,466 terms) -->
  <div id="onScreenDictDrawer" class="dict-drawer-backdrop" aria-hidden="true">
    <div class="dict-drawer-panel">
      <div class="dict-drawer-header">
        <div class="dict-drawer-title-group">
          <div class="dict-drawer-heading font-sans">
            <span>📖</span> Śāṅkara Bhāṣya & Mūla Lexicon
          </div>
          <div class="dict-drawer-subheading font-sans">
            132,466 Philosophical & Classical Sanskrit Terms
          </div>
        </div>
        <div class="dict-drawer-actions">
          <a href="/bhashya-dictionary" target="_blank" class="dict-full-link font-sans" title="Open full lexicon in new tab">
            <span>Full Lexicon</span> ↗
          </a>
          <button id="closeDictDrawerBtn" class="dict-drawer-close" aria-label="Close Dictionary">✕</button>
        </div>
      </div>

      <div class="dict-drawer-search-area">
        <div class="dict-input-wrap">
          <span class="dict-input-icon">🔍</span>
          <input 
            type="text" 
            id="onScreenDictInput" 
            class="dict-input font-devanagari" 
            placeholder="Search word (Devanagari or Roman: brahman, maya, atman)..." 
            autocomplete="off"
            spellcheck="false"
          />
          <button id="clearDictInputBtn" class="dict-clear-btn" style="display: none;">✕</button>
        </div>
        <div class="dict-scope-pills" id="dictScopePills">
          <button class="scope-pill active" data-scope="all">All (132k)</button>
          <button class="scope-pill" data-scope="bhasya">Śāṅkara Bhāṣya (95k)</button>
          <button class="scope-pill" data-scope="mula">Mūla Texts (36k)</button>
        </div>
      </div>

      <div class="dict-drawer-content" id="dictContentScroll">
        <div id="dictActiveEntryCard" class="dict-active-entry-card" style="display: none;"></div>
        <div id="dictSearchResultsList" class="dict-results-list"></div>
        <div id="dictEmptyState" class="dict-empty-state">
          <span class="dict-empty-icon">🕉️</span>
          <h4 class="font-serif">Instant Sanskrit Lexicon</h4>
          <p class="font-lora">Click any word in the shlokas or padaccheda to inspect its root, grammar, and Śāṅkara definition.</p>
        </div>
      </div>
    </div>
  </div>

</div>

<script>
  import { toDevanagari } from '../utils/dictionaryService';

  // Global state for Adhyātma Compendium
  let summaryData = null;
  let ontologyData = null;
  let currentKandaData = null;
  let currentKandaNum = 1;
  let currentSargaNum = 1;
  let currentEventId = '';
  let kandaCache = {};
  let flaggedVerses = {};

  try {
    const rawFlags = localStorage.getItem('adhyatma_ramayana_flags');
    if (rawFlags) flaggedVerses = JSON.parse(rawFlags);
  } catch (e) {
    flaggedVerses = {};
  }

  function saveFlags() {
    try {
      localStorage.setItem('adhyatma_ramayana_flags', JSON.stringify(flaggedVerses));
    } catch (e) {}
    updateFlaggedCountUI();
  }

  function updateFlaggedCountUI() {
    const count = Object.keys(flaggedVerses).length;
    const badge = document.getElementById('topbarFlagCount');
    if (badge) {
      badge.textContent = `${count} Flagged`;
    }
  }

  async function init() {
    const root = document.getElementById('adhyatmaCompendiumApp');
    if (!root) return;

    updateFlaggedCountUI();

    // Parse URL params or fallback to attributes
    const params = new URLSearchParams(window.location.search);
    const pK = parseInt(params.get('k') || root.getAttribute('data-initial-kanda') || '1', 10);
    const pS = parseInt(params.get('s') || root.getAttribute('data-initial-sarga') || '1', 10);
    const pE = params.get('e') || root.getAttribute('data-initial-event') || '';

    currentKandaNum = Math.min(Math.max(1, pK), 7);
    currentSargaNum = pS;
    currentEventId = pE;

    setupEventListeners();

    // 1. Fetch Summary & Ontology
    try {
      const [sumRes, ontRes] = await Promise.all([
        fetch('/data/adhyatma-ramayana/summary.json'),
        fetch('/data/adhyatma-ramayana/ontology.json')
      ]);
      summaryData = await sumRes.json();
      ontologyData = await ontRes.json();
      setupHighlightsModal(summaryData.high_density_highlights || []);
    } catch (err) {
      console.error('Error loading scripture metadata:', err);
    }

    // 2. Load Initial Kanda
    await loadKanda(currentKandaNum, currentSargaNum, currentEventId);
  }

  async function loadKanda(kNum, targetSarga = 1, targetEventId = '') {
    currentKandaNum = kNum;
    
    // Update select
    const kSelect = document.getElementById('kandaSelect') as HTMLSelectElement;
    if (kSelect) kSelect.value = String(kNum);

    if (kandaCache[kNum]) {
      currentKandaData = kandaCache[kNum];
    } else {
      try {
        const res = await fetch(`/data/adhyatma-ramayana/kandas/kanda_${kNum}.json`);
        currentKandaData = await res.json();
        kandaCache[kNum] = currentKandaData;
      } catch (err) {
        console.error(`Failed to load Kanda ${kNum}:`, err);
        return;
      }
    }

    populateSargaSelect(currentKandaData, targetSarga);
    switchSarga(targetSarga, targetEventId);
  }

  function populateSargaSelect(kData, activeSarga) {
    const sSelect = document.getElementById('sargaSelect') as HTMLSelectElement;
    if (!sSelect) return;
    sSelect.innerHTML = kData.sargas.map(s => 
      `<option value="${s.sarga_number}" ${s.sarga_number === activeSarga ? 'selected' : ''}>Sarga ${s.sarga_number}: ${s.title.slice(0, 32)}</option>`
    ).join('');
  }

  function switchSarga(sNum, targetEventId = '') {
    if (!currentKandaData) return;
    const sarga = currentKandaData.sargas.find(s => s.sarga_number === sNum) || currentKandaData.sargas[0];
    currentSargaNum = sarga.sarga_number;

    const sSelect = document.getElementById('sargaSelect') as HTMLSelectElement;
    if (sSelect) sSelect.value = String(currentSargaNum);

    // Update rail & drawer headers
    const railKanda = document.getElementById('railKandaLabel');
    const railSarga = document.getElementById('railSargaTitle');
    const railCount = document.getElementById('railEventCount');
    const drawerLabel = document.getElementById('drawerSargaLabel');

    if (railKanda) railKanda.textContent = `${currentKandaData.name} (${currentKandaData.name_sanskrit})`;
    if (railSarga) railSarga.textContent = `Sarga ${sarga.sarga_number}: ${sarga.title}`;
    if (railCount) railCount.textContent = `${sarga.events_count} Episodes • ${sarga.verse_count} Shlokas`;
    if (drawerLabel) drawerLabel.textContent = `Sarga ${sarga.sarga_number}: ${sarga.title}`;

    // Render events list in rail and drawer
    renderEventList(sarga.events, targetEventId);
  }

  const KANDA_NAMES = ['', 'Bālakāṇḍa', 'Ayodhyākāṇḍa', 'Āraṇyakāṇḍa', 'Kiṣkindhākāṇḍa', 'Sundarakāṇḍa', 'Yuddhakāṇḍa', 'Uttarakāṇḍa'];

  function humanizeEventType(rawType) {
    const map = {
      'cosmic_theology': 'Cosmic Revelation',
      'philosophical_discourse': 'Advaita Discourse',
      'epic_narrative': 'Sacred Narrative',
      'hymn_of_praise': 'Devotional Hymn (Stotra)',
      'ritual_initiation': 'Sacred Initiation',
      'spiritual_counsel': 'Spiritual Counsel',
      'theological_exposition': 'Non-Dual Exposition',
      'dialogue_instruction': 'Instructional Dialogue',
      'stotra': 'Devotional Hymn'
    };
    if (!rawType) return 'Sacred Narrative';
    return map[rawType] || rawType.split('_').map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase()).join(' ');
  }

  function cleanString(str) {
    if (!str || str === 'None' || str === 'Unidentified_Or_None' || str === 'No_Symbolic_Interpretation') return '';
    return str.replace(/_/g, ' ');
  }

  function renderEventList(events, targetEventId = '') {
    const railContainer = document.getElementById('railEventsContainer');
    const drawerContainer = document.getElementById('drawerEventsContainer');

    let activeEvent = events.find(e => e.segment_id === targetEventId) || events[0];
    currentEventId = activeEvent ? activeEvent.segment_id : '';

    const html = events.map((e, idx) => {
      const isActive = e.segment_id === currentEventId;
      const epNum = idx + 1;
      const density = e.philosophy?.density || 'MEDIUM';
      const isLandmark = density === 'VERY_HIGH' || density === 'HIGH';
      const vCount = e.verses?.length || (e.end_verse - e.start_verse + 1);

      return `
        <div class="rail-event-card ${isActive ? 'active' : ''}" data-event-id="${e.segment_id}" tabindex="0" role="button">
          <div class="rec-top">
            <span class="rec-number font-sans">Episode ${epNum}</span>
            <span class="rec-range font-sans">Verses ${e.start_verse}–${e.end_verse}</span>
          </div>
          <div class="rec-title font-sans">${e.event?.title || 'Episode ' + epNum}</div>
          <div class="rec-bottom">
            ${isLandmark ? '<span class="rec-highlight-tag">⭐ Key Teaching</span>' : '<span class="rec-tag-narrative">Narrative</span>'}
            <span class="rec-count">${vCount} ${vCount === 1 ? 'Verse' : 'Verses'}</span>
          </div>
        </div>
      `;
    }).join('');

    if (railContainer) {
      railContainer.innerHTML = html;
      railContainer.querySelectorAll('.rail-event-card').forEach(card => {
        card.addEventListener('click', () => {
          const eid = card.getAttribute('data-event-id');
          if (eid) selectEvent(eid);
        });
      });
    }

    if (drawerContainer) {
      drawerContainer.innerHTML = html;
      drawerContainer.querySelectorAll('.rail-event-card').forEach(card => {
        card.addEventListener('click', () => {
          const eid = card.getAttribute('data-event-id');
          if (eid) {
            selectEvent(eid);
            closeEventDrawer();
          }
        });
      });
    }

    if (activeEvent) {
      renderActiveEvent(activeEvent);
    }
  }

  function selectEvent(eventId) {
    if (!currentKandaData) return;
    const sarga = currentKandaData.sargas.find(s => s.sarga_number === currentSargaNum);
    if (!sarga) return;

    const event = sarga.events.find(e => e.segment_id === eventId);
    if (!event) return;

    currentEventId = eventId;

    // Update active highlight in rail & drawer
    document.querySelectorAll('.rail-event-card').forEach(c => {
      c.classList.toggle('active', c.getAttribute('data-event-id') === eventId);
    });

    renderActiveEvent(event);
    updateUrl();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function renderActiveEvent(eventObj) {
    const sarga = currentKandaData?.sargas.find(s => s.sarga_number === currentSargaNum);
    const epIndex = sarga ? sarga.events.findIndex(e => e.segment_id === eventObj.segment_id) + 1 : 1;
    const totalEps = sarga ? sarga.events.length : 1;

    // 1. Hero Elements
    const hId = document.getElementById('heroEventId');
    const hType = document.getElementById('heroEventType');
    const hRange = document.getElementById('heroVerseRange');
    const hTitle = document.getElementById('heroEventTitle');
    const hSummary = document.getElementById('heroEventSummary');
    const totalEl = document.getElementById('eventVerseTotal');

    if (hId) hId.textContent = `Episode ${epIndex} of ${totalEps}`;
    if (hType) hType.textContent = humanizeEventType(eventObj.event?.event_type);
    if (hRange) hRange.textContent = `Verses ${eventObj.start_verse} to ${eventObj.end_verse} (${eventObj.verses?.length || 0} Shlokas)`;
    if (hTitle) hTitle.textContent = eventObj.event?.title || `Episode ${epIndex}`;
    if (hSummary) hSummary.textContent = eventObj.event?.summary || '';
    if (totalEl) totalEl.textContent = String(eventObj.verses?.length || 0);

    // 2. Ontology Chips
    const ontContainer = document.getElementById('heroOntologyPills');
    if (ontContainer) {
      const refs = eventObj.philosophy?.ontology_refs || [];
      if (refs.length === 0) {
        ontContainer.innerHTML = '<span class="empty-pill-text font-lora">Bhakti and Jñāna synthesis seamlessly woven into the narrative</span>';
      } else {
        ontContainer.innerHTML = refs.map(r => {
          const ontInfo = ontologyData ? ontologyData[r] : null;
          const label = ontInfo ? ontInfo.term : r.replace('ADV-CAND-', '').replace(/_/g, ' ');
          return `<button class="ont-chip-btn font-sans" data-ref="${r}" title="Click to view definition">🕉️ ${label}</button>`;
        }).join('');

        ontContainer.querySelectorAll('.ont-chip-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const r = btn.getAttribute('data-ref');
            if (r) openOntologyModal(r);
          });
        });
      }
    }

    // 3. Characters & Cosmic Mappings
    const charContainer = document.getElementById('heroCharactersPills');
    if (charContainer) {
      const chars = eventObj.characters || [];
      const mappings = eventObj.character_cosmic_mappings || [];
      const mapDict = {};
      mappings.forEach(m => { mapDict[m.character_name] = m.cosmic_identity; });

      if (chars.length === 0) {
        charContainer.innerHTML = '<span class="empty-pill-text font-lora">Seekers and divine personages</span>';
      } else {
        charContainer.innerHTML = chars.map(c => {
          const cleanChar = cleanString(c);
          const rawPrinciple = mapDict[c] ? cleanString(mapDict[c]) : '';
          const principle = rawPrinciple ? ` (${rawPrinciple})` : '';
          return `<span class="char-pill font-sans">👤 ${cleanChar}<small>${principle}</small></span>`;
        }).join('');
      }
    }

    // 4. Setting, Allegory & Context Strip
    const ctxStrip = document.getElementById('heroContextStrip');
    if (ctxStrip) {
      const place = cleanString(eventObj.place) || 'Sacred Setting';
      const symbolicMeaning = cleanString(eventObj.place_symbolic_meaning);
      const symbolic = symbolicMeaning ? ` • <em class="allegory-tag">Spiritual Allegory: ${symbolicMeaning}</em>` : '';
      const doctrineStr = cleanString(eventObj.philosophy?.primary_doctrine);
      const doctrine = doctrineStr ? ` • Core Doctrine: <strong>${doctrineStr}</strong>` : '';

      ctxStrip.innerHTML = `
        <div class="ctx-item">
          <strong>Sacred Locus:</strong> ${place}${symbolic}
        </div>
        ${doctrine ? `<div class="ctx-item">${doctrine}</div>` : ''}
      `;
    }

    // 5. Render Verses Stream
    renderVersesStream(eventObj.verses || []);

    // 6. Update Pager
    updatePagerButtons();
  }

  function renderVersesStream(verses) {
    const container = document.getElementById('versesContainer');
    if (!container) return;

    if (!verses || verses.length === 0) {
      container.innerHTML = `<div class="empty-verses-card font-lora">No verses loaded for this episode.</div>`;
      return;
    }

    const kandaName = KANDA_NAMES[currentKandaNum] || 'Kāṇḍa';

    container.innerHTML = verses.map(v => {
      const verseKey = `${currentKandaNum}_${v.sarga_number}_${v.verse_number}`;
      const isFlagged = Boolean(flaggedVerses[verseKey]);
      const flagNote = isFlagged ? (flaggedVerses[verseKey].note || 'Flagged for review') : '';
      const humanCoord = `${kandaName} • Sarga ${v.sarga_number} • Shloka ${v.verse_number}`;

      const speakerName = cleanString(v.speaker);
      const listenerName = cleanString(v.listener);
      const speakerInfo = speakerName 
        ? `<span class="verse-speaker-tag font-sans">🗣️ ${speakerName}${listenerName ? ` → ${listenerName}` : ''}</span>`
        : '';

      const meterName = cleanString(v.meter);
      const meterTag = meterName ? `<span class="verse-meter-tag font-sans">${meterName}</span>` : '';
      const stotraName = cleanString(v.stotra_name);
      const stotraTag = stotraName ? `<span class="verse-stotra-tag font-sans">🎼 ${stotraName}</span>` : '';

      // Padacheda cards
      let padaHtml = '';
      if (v.padacheda && v.padacheda.length > 0) {
        padaHtml = `
          <details class="padacheda-accordion">
            <summary class="padacheda-summary font-sans">
              <span>📖 Word-by-Word Analysis (${v.padacheda.length} words)</span>
              <span class="acc-arrow">▾</span>
            </summary>
            <div class="padacheda-grid">
              ${v.padacheda.map(pw => `
                <div class="pada-card interactive-pada-token" data-word="${pw.sanskrit_word}">
                  <div class="pada-word font-devanagari">${pw.sanskrit_word}</div>
                  <div class="pada-eng font-lora">${pw.meaning_english || ''}</div>
                  ${pw.meaning_hindi ? `<div class="pada-hin font-devanagari">${pw.meaning_hindi}</div>` : ''}
                </div>
              `).join('')}
            </div>
          </details>
        `;
      }

      const docStr = cleanString(v.doctrine);
      const prakStr = cleanString(v.prakriya);
      const sadhStr = cleanString(v.sadhana_stage);
      const hasTheology = docStr || prakStr || sadhStr;

      return `
        <article class="verse-card ${isFlagged ? 'verse-flagged' : ''}" id="verseCard_${verseKey}" data-verse-key="${verseKey}">
          <div class="verse-card-header">
            <div class="verse-coord-badge font-sans">
              ${humanCoord}
            </div>

            <div class="verse-header-tags">
              ${speakerInfo}
              ${meterTag}
              ${stotraTag}
            </div>

            <div class="verse-flag-action">
              <button class="flag-toggle-btn ${isFlagged ? 'active' : ''}" data-key="${verseKey}" title="${isFlagged ? 'Click to unflag' : 'Flag this verse for review / translation check'}">
                <span>🚩</span>
                <span class="flag-btn-text">${isFlagged ? 'Flagged' : 'Flag for Review'}</span>
              </button>
            </div>
          </div>

          <!-- Flagged Note Banner if Active -->
          <div class="flag-note-banner ${isFlagged ? 'show' : ''}" id="flagBanner_${verseKey}">
            <span class="flag-note-icon">⚠️</span>
            <span class="flag-note-text" id="flagText_${verseKey}">${flagNote}</span>
            <button class="flag-edit-btn" data-key="${verseKey}" title="Edit review note">✏️</button>
          </div>

          <!-- Sanskrit Shloka -->
          <div class="verse-sanskrit-box font-devanagari">
            ${formatInteractiveTokens(v.sanskrit)}
          </div>

          <!-- IAST Transliteration -->
          <div class="verse-translit-box font-lora">
            ${v.transliteration}
          </div>

          <!-- Flowing Translations -->
          <div class="verse-translations-box">
            <div class="trans-item trans-english">
              <div class="trans-header-row">
                <span class="trans-lang-label font-sans">
                  <span class="trans-lang-icon">🌐</span> English Translation
                </span>
              </div>
              <div class="trans-content font-lora">${v.translation_english}</div>
            </div>

            ${v.translation_hindi ? `
              <div class="trans-item trans-hindi">
                <div class="trans-header-row">
                  <span class="trans-lang-label font-sans">
                    <span class="trans-lang-icon">🕉️</span> हिन्दी अनुवाद
                  </span>
                </div>
                <div class="trans-content font-devanagari">${v.translation_hindi}</div>
              </div>
            ` : ''}
          </div>

          <!-- Word by word -->
          ${padaHtml}

          <!-- Theological & Sadhanic Metadata Strip -->
          ${hasTheology ? `
            <div class="verse-theology-strip">
              ${docStr ? `<span class="theo-chip font-sans"><strong>Doctrine:</strong> ${docStr}</span>` : ''}
              ${prakStr ? `<span class="theo-chip font-sans"><strong>Prakriyā:</strong> ${prakStr}</span>` : ''}
              ${sadhStr ? `<span class="theo-chip font-sans"><strong>Sādhana:</strong> ${sadhStr}</span>` : ''}
            </div>
          ` : ''}
        </article>
      `;
    }).join('');

    // Attach interactive word token triggers
    container.querySelectorAll('.shloka-word-token, .interactive-pada-token').forEach(el => {
      el.addEventListener('click', (e) => {
        const raw = el.getAttribute('data-word') || el.textContent;
        const clean = (raw || '').replace(/[\s\u0964\u0965\.\,\-\:\;\|\!\?\'\"0-9०-९\(\)]/g, '').trim();
        if (clean) openDictionaryWithWord(clean);
      });
    });

    // Attach flag buttons
    container.querySelectorAll('.flag-toggle-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-key');
        if (key) toggleVerseFlag(key);
      });
    });

    container.querySelectorAll('.flag-edit-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-key');
        if (key) promptEditFlag(key);
      });
    });
  }

  function formatInteractiveTokens(sanskritText) {
    if (!sanskritText) return '';
    return sanskritText.split('\n').map(line => {
      const words = line.trim().split(/\s+/);
      const taggedWords = words.map(w => {
        const clean = w.replace(/[\s\u0964\u0965\.\,\-\:\;\|\!\?\'\"0-9०-९\(\)]/g, '').trim();
        if (!clean) return w;
        return `<span class="shloka-word-token" data-word="${clean}">${w}</span>`;
      }).join(' ');
      return `<div class="shloka-line">${taggedWords}</div>`;
    }).join('');
  }

  function toggleVerseFlag(verseKey) {
    if (flaggedVerses[verseKey]) {
      delete flaggedVerses[verseKey];
    } else {
      const defaultNote = 'Translation review needed';
      const userNote = prompt('Flag verse for review. Optional note:', defaultNote);
      flaggedVerses[verseKey] = {
        key: verseKey,
        note: userNote || defaultNote,
        timestamp: new Date().toISOString()
      };
    }
    saveFlags();

    // Update UI for this card
    const card = document.getElementById(`verseCard_${verseKey}`);
    const banner = document.getElementById(`flagBanner_${verseKey}`);
    const textEl = document.getElementById(`flagText_${verseKey}`);
    const btn = card?.querySelector('.flag-toggle-btn');

    if (card && btn) {
      const isFlagged = Boolean(flaggedVerses[verseKey]);
      card.classList.toggle('verse-flagged', isFlagged);
      btn.classList.toggle('active', isFlagged);
      const btnText = btn.querySelector('.flag-btn-text');
      if (btnText) btnText.textContent = isFlagged ? 'Flagged' : 'Flag for Review';
      if (banner) banner.classList.toggle('show', isFlagged);
      if (textEl && isFlagged) textEl.textContent = flaggedVerses[verseKey].note;
    }
  }

  function promptEditFlag(verseKey) {
    if (!flaggedVerses[verseKey]) return;
    const current = flaggedVerses[verseKey].note || '';
    const updated = prompt('Update note for this flagged verse:', current);
    if (updated !== null) {
      flaggedVerses[verseKey].note = updated;
      saveFlags();
      const textEl = document.getElementById(`flagText_${verseKey}`);
      if (textEl) textEl.textContent = updated;
    }
  }

  function updatePagerButtons() {
    if (!currentKandaData) return;
    const sarga = currentKandaData.sargas.find(s => s.sarga_number === currentSargaNum);
    if (!sarga) return;

    const events = sarga.events;
    const curIdx = events.findIndex(e => e.segment_id === currentEventId);

    const prevBtn = document.getElementById('prevEventBtn');
    const nextBtn = document.getElementById('nextEventBtn');
    const fPrev = document.getElementById('footerPrevBtn');
    const fNext = document.getElementById('footerNextBtn');
    const fPrevLabel = document.getElementById('footerPrevLabel');
    const fNextLabel = document.getElementById('footerNextLabel');

    const hasPrev = curIdx > 0;
    const hasNext = curIdx < events.length - 1;

    if (prevBtn) (prevBtn as HTMLButtonElement).disabled = !hasPrev;
    if (nextBtn) (nextBtn as HTMLButtonElement).disabled = !hasNext;
    if (fPrev) (fPrev as HTMLButtonElement).disabled = !hasPrev;
    if (fNext) (fNext as HTMLButtonElement).disabled = !hasNext;

    if (hasPrev && fPrevLabel) fPrevLabel.textContent = events[curIdx - 1].event?.title || 'Previous';
    if (hasNext && fNextLabel) fNextLabel.textContent = events[curIdx + 1].event?.title || 'Next';
  }

  function goToAdjacentEvent(delta) {
    if (!currentKandaData) return;
    const sarga = currentKandaData.sargas.find(s => s.sarga_number === currentSargaNum);
    if (!sarga) return;

    const events = sarga.events;
    const curIdx = events.findIndex(e => e.segment_id === currentEventId);
    const targetIdx = curIdx + delta;

    if (targetIdx >= 0 && targetIdx < events.length) {
      selectEvent(events[targetIdx].segment_id);
    }
  }

  function updateUrl() {
    const url = new URL(window.location.href);
    url.searchParams.set('k', String(currentKandaNum));
    url.searchParams.set('s', String(currentSargaNum));
    url.searchParams.set('e', currentEventId);
    window.history.replaceState({}, '', url.toString());
  }

  function setupEventListeners() {
    // Selectors
    const kSelect = document.getElementById('kandaSelect') as HTMLSelectElement;
    if (kSelect) {
      kSelect.addEventListener('change', (e) => {
        const val = parseInt((e.target as HTMLSelectElement).value, 10);
        loadKanda(val, 1);
      });
    }

    const sSelect = document.getElementById('sargaSelect') as HTMLSelectElement;
    if (sSelect) {
      sSelect.addEventListener('change', (e) => {
        const val = parseInt((e.target as HTMLSelectElement).value, 10);
        switchSarga(val);
      });
    }

    // Pager buttons
    document.getElementById('prevEventBtn')?.addEventListener('click', () => goToAdjacentEvent(-1));
    document.getElementById('nextEventBtn')?.addEventListener('click', () => goToAdjacentEvent(1));
    document.getElementById('footerPrevBtn')?.addEventListener('click', () => goToAdjacentEvent(-1));
    document.getElementById('footerNextBtn')?.addEventListener('click', () => goToAdjacentEvent(1));

    // Drawer triggers
    document.getElementById('openEventDrawerBtn')?.addEventListener('click', openEventDrawer);
    document.getElementById('closeDrawerBtn')?.addEventListener('click', closeEventDrawer);
    document.getElementById('eventDrawerBackdrop')?.addEventListener('click', (e) => {
      if (e.target === e.currentTarget) closeEventDrawer();
    });

    // Highlights modal
    document.getElementById('openHighlightsBtn')?.addEventListener('click', openHighlightsModal);
    document.getElementById('closeHighlightsBtn')?.addEventListener('click', closeHighlightsModal);
    document.getElementById('highlightsModal')?.addEventListener('click', (e) => {
      if (e.target === e.currentTarget) closeHighlightsModal();
    });

    // Flagged drawer
    document.getElementById('openFlaggedDrawerBtn')?.addEventListener('click', openFlaggedDrawer);
    document.getElementById('closeFlaggedDrawerBtn')?.addEventListener('click', closeFlaggedDrawer);
    document.getElementById('flaggedDrawer')?.addEventListener('click', (e) => {
      if (e.target === e.currentTarget) closeFlaggedDrawer();
    });

    document.getElementById('clearAllFlagsBtn')?.addEventListener('click', () => {
      if (confirm('Clear all flagged verses?')) {
        flaggedVerses = {};
        saveFlags();
        renderFlaggedVersesList();
        // Refresh verses stream
        if (currentKandaData) {
          const sarga = currentKandaData.sargas.find(s => s.sarga_number === currentSargaNum);
          const event = sarga?.events.find(e => e.segment_id === currentEventId);
          if (event) renderVersesStream(event.verses);
        }
      }
    });

    // Ontology modal
    document.getElementById('closeOntologyModalBtn')?.addEventListener('click', closeOntologyModal);
    document.getElementById('ontologyModal')?.addEventListener('click', (e) => {
      if (e.target === e.currentTarget) closeOntologyModal();
    });

    // Dictionary buttons
    document.getElementById('openDictBtn')?.addEventListener('click', () => openDictionaryWithWord('ब्रह्म'));
    document.getElementById('closeDictDrawerBtn')?.addEventListener('click', closeDictionary);
    document.getElementById('onScreenDictDrawer')?.addEventListener('click', (e) => {
      if (e.target === e.currentTarget) closeDictionary();
    });

    // Keyboard shortcuts
    window.addEventListener('keydown', (e) => {
      if (['INPUT', 'TEXTAREA'].includes((e.target as HTMLElement)?.tagName)) return;
      if (e.key === 'ArrowLeft') goToAdjacentEvent(-1);
      if (e.key === 'ArrowRight') goToAdjacentEvent(1);
      if (e.key === 'd' || e.key === 'D') openDictionaryWithWord('ब्रह्म');
      if (e.key === 'Escape') {
        closeEventDrawer();
        closeHighlightsModal();
        closeFlaggedDrawer();
        closeOntologyModal();
        closeDictionary();
      }
    });
  }

