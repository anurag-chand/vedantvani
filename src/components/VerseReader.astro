    /**
     * Parse Sanskrit shloka text into clickable word tokens
     */
    function formatSanskritTokens(rawText) {
      if (!rawText) return '';
      const lines = rawText.split('\n');
      return lines.map(line => {
        const tokens = line.split(/(\s+|[।॥\-\,\.\:\;\"\'\(\)0-9०-९]+)/g);
        return tokens.map(tok => {
          if (!tok || !tok.trim() || /^[।॥\-\,\.\:\;\"\'\(\)0-9०-९\s]+$/.test(tok)) {
            return tok;
          }
          const cleanWord = tok.replace(/[\s\u0964\u0965\.\,\-\:\;\|\!\?\'\"0-9०-९\(\)]/g, '').trim();
          if (!cleanWord || !/[\u0900-\u097F]/.test(cleanWord)) {
            return tok;
          }
          return `<span class="shloka-word-token" data-word="${cleanWord}" tabindex="0" role="button" title="Click to lookup: ${cleanWord}">${tok}</span>`;
        }).join('');
      }).join('<br/>');
    }

    /**
     * Populate verse vocabulary chips inside the on-screen dictionary
     */
    function updateVerseVocabChips(verseObj) {
      if (!verseVocabChipsEl) return;
      if (!verseObj) {
        verseVocabChipsEl.innerHTML = '<span style="font-size: 0.8rem; color: var(--text-muted);">No vocabulary loaded.</span>';
        if (vocabCountBadge) vocabCountBadge.textContent = '0 words';
        return;
      }

      const wordsList = [];
      const seen = new Set();

      if (Array.isArray(verseObj.word_by_word) && verseObj.word_by_word.length > 0) {
        verseObj.word_by_word.forEach(w => {
          const raw = (w.word_sanskrit || '').replace(/[\s\u0964\u0965\.\,\-\:\;\|\!\?\'\"0-9०-९\(\)]/g, '').trim();
          if (raw && !seen.has(raw)) {
            seen.add(raw);
            wordsList.push(raw);
          }
        });
      }

      if (wordsList.length === 0 && (verseObj.sanskrit_shloka || verseObj.text)) {
        const text = verseObj.sanskrit_shloka || verseObj.text || '';
        const tokens = text.split(/[\s\u0964\u0965\.\,\-\:\;\|\!\?\'\"0-9०-९\(\)]+/);
        tokens.forEach(tok => {
          const clean = tok.trim();
          if (clean && /[\u0900-\u097F]/.test(clean) && !seen.has(clean)) {
            seen.add(clean);
            wordsList.push(clean);
          }
        });
      }

      if (vocabCountBadge) {
        vocabCountBadge.textContent = `${wordsList.length} words`;
      }

      if (wordsList.length === 0) {
        verseVocabChipsEl.innerHTML = '<span style="font-size: 0.8rem; color: var(--text-muted);">No distinct terms indexed in this verse.</span>';
        return;
      }

      verseVocabChipsEl.innerHTML = wordsList.map(w => `
        <button class="vocab-chip font-devanagari" data-word="${w}" title="Lookup ${w}">
          ${w}
        </button>
      `).join('');
    }

    /**
     * Query Word Entry with Worker D1 primary & local shard fallback
     */
    async function fetchWordEntry(rawWord) {
      const word = rawWord.replace(/[\s\u0964\u0965\.\,\-\:\;\|\!\?\'\"0-9०-९\(\)]/g, '').trim();
      if (!word) return null;

      const cacheKey = `${activeDictScope}:${word}`;
      if (dictMemoryCache[cacheKey]) return dictMemoryCache[cacheKey];

      // Check current verse word_by_word for fast local contextual data
      let localVerseMatch = null;
      const currentVerseObj = currentVersesData[currentVerse - 1];
      if (currentVerseObj && Array.isArray(currentVerseObj.word_by_word)) {
        const found = currentVerseObj.word_by_word.find(w => {
          const s = (w.word_sanskrit || '').replace(/[\s\u0964\u0965\.\,\-\:\;\|\!\?\'\"0-9०-९\(\)]/g, '').trim();
          return s === word || s.includes(word) || word.includes(s);
        });
        if (found) {
          localVerseMatch = {
            source: 'mula',
            surface: found.word_sanskrit || word,
            padaccheda: found.root || found.word_sanskrit || word,
            grammar: found.grammar_role || '',
            meaning_en: found.word_english || '',
            confidence: 'h',
            work_slug: scripture.name,
            unit_key: `Ch ${currentChapter} • V ${currentVerse}`
          };
        }
      }

      // 1. Query Cloudflare Worker D1 API
      const workerUrl = getWorkerUrl();
      if (workerUrl) {
        try {
          const res = await fetch(`${workerUrl}/api/dict/word?term=${encodeURIComponent(word)}&scope=${activeDictScope}`);
          if (res.ok) {
            const data = await res.json();
            if (data && data.surface) {
              if (localVerseMatch && !data.meaning_en) {
                data.meaning_en = localVerseMatch.meaning_en;
              }
              dictMemoryCache[cacheKey] = data;
              return data;
            }
          }
        } catch (e) {
          console.warn('Worker word lookup error:', e);
        }
      }

      // 2. Fallback to local static shards
      try {
        const shardFile = getShardFilename(word);
        if (shardFile) {
          let shardJson = shardCache[shardFile];
          if (!shardJson) {
            const res = await fetch(`/data/dict/${shardFile}`);
            if (res.ok) {
              shardJson = await res.json();
              shardCache[shardFile] = shardJson;
            }
          }
          if (shardJson && shardJson[word]) {
            const val = shardJson[word];
            const entry = {
              source: 'bhasya',
              surface: word,
              padaccheda: val.p || word,
              grammar: val.g || '',
              meaning_en: val.m || '',
              confidence: val.c || 'h',
              meaning_bn: val.mb || ''
            };
            dictMemoryCache[cacheKey] = entry;
            return entry;
          }
        }
      } catch (e) {
        console.warn('Local shard lookup error:', e);
      }

      // 3. Return local verse match if available
      if (localVerseMatch) {
        dictMemoryCache[cacheKey] = localVerseMatch;
        return localVerseMatch;
      }

      return null;
    }

    /**
     * Search words across dictionary (Worker + local fallback)
     */
    async function searchWords(query) {
      const q = query.trim();
      if (!q) return [];

      const workerUrl = getWorkerUrl();
      if (workerUrl) {
        try {
          const res = await fetch(`${workerUrl}/api/dict/search?q=${encodeURIComponent(q)}&scope=${activeDictScope}&limit=20`);
          if (res.ok) {
            const list = await res.json();
            if (Array.isArray(list)) return list;
          }
        } catch (e) {
          console.warn('Worker search error:', e);
        }
      }

      // Shard search fallback
      try {
        const devaQ = /[\u0900-\u097F]/.test(q) ? q : toDevanagari(q);
        const shardFile = getShardFilename(devaQ);
        if (shardFile) {
          let shardJson = shardCache[shardFile];
          if (!shardJson) {
            const res = await fetch(`/data/dict/${shardFile}`);
            if (res.ok) {
              shardJson = await res.json();
              shardCache[shardFile] = shardJson;
            }
          }
          if (shardJson) {
            const matches = [];
            for (const [term, val] of Object.entries(shardJson)) {
              if (term.includes(devaQ) || (val.p && val.p.includes(devaQ)) || (val.m && val.m.toLowerCase().includes(q.toLowerCase()))) {
                matches.push({
                  source: 'bhasya',
                  surface: term,
                  padaccheda: val.p || term,
                  grammar: val.g || '',
                  meaning_en: val.m || '',
                  confidence: val.c || 'h'
                });
                if (matches.length >= 20) break;
              }
            }
            return matches;
          }
        }
      } catch (e) {}

      return [];
    }

