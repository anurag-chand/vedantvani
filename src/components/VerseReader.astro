          </div>
        </div>
      `).join('');

      dictSearchResultsList.innerHTML = html;
    }

    /**
     * Show compact floating popover positioned near target element or mouse coords
     */
    function showFloatingPopover(entry, targetEl, clientX, clientY) {
      if (!popoverEl) return;
      popoverCurrentWord = entry.surface;

      if (popoverSurfaceEl) popoverSurfaceEl.textContent = entry.surface;
      if (popoverSourceTag) {
        popoverSourceTag.textContent = entry.source === 'mula' ? 'Mūla' : 'Bhāṣya';
        popoverSourceTag.style.display = 'inline-block';
      }
      if (popoverPadacchedaEl) {
        popoverPadacchedaEl.textContent = (entry.padaccheda && entry.padaccheda !== entry.surface) ? `Root: ${entry.padaccheda}` : '';
      }
      if (popoverGrammarEl) {
        popoverGrammarEl.textContent = entry.grammar || '';
        popoverGrammarEl.style.display = entry.grammar ? 'inline-block' : 'none';
      }
      if (popoverMeaningEl) {
        popoverMeaningEl.textContent = entry.meaning_en || 'Glossed in sacred text.';
      }
      if (popoverFullLinkEl) {
        popoverFullLinkEl.href = `/bhashya-dictionary?q=${encodeURIComponent(entry.surface)}`;
      }

      let posX = clientX;
      let posY = clientY;

      if (targetEl && targetEl.getBoundingClientRect) {
        const rect = targetEl.getBoundingClientRect();
        posX = rect.left + rect.width / 2;
        posY = rect.bottom + 8;
      }

      const x = Math.min(Math.max(16, posX - 120), window.innerWidth - 340);
      const y = Math.min(posY, window.innerHeight - 220);

      popoverEl.style.left = `${x}px`;
      popoverEl.style.top = `${y}px`;
      popoverEl.style.display = 'block';
    }

    /**
     * Main word lookup handler invoked by clicks on tokens, breakdown cards, or commentary
     */
    async function handleWordLookup(rawWord, targetEl = null, clientX = 200, clientY = 200) {
      const cleanWord = rawWord.replace(/[\s\u0964\u0965\.\,\-\:\;\|\!\?\'\"0-9०-९\(\)]/g, '').trim();
      if (!cleanWord) return;

      // If drawer is already open, show directly inside drawer
      if (dictDrawer && dictDrawer.classList.contains('open')) {
        displayWordInDrawer(cleanWord);
        return;
      }

      // Otherwise fetch entry and display floating popover
      const entry = await fetchWordEntry(cleanWord);
      if (entry) {
        showFloatingPopover(entry, targetEl, clientX, clientY);
      } else {
        // If not exact match, open drawer to display full search
        openDictDrawer(cleanWord);
      }
    }

    // ==========================================
    // EVENT LISTENERS FOR ON-SCREEN DICTIONARY
    // ==========================================

    // 1. Shloka Words Token Click
    if (sanskritEl) {
      sanskritEl.addEventListener('click', (e) => {
        const token = e.target.closest('.shloka-word-token');
        if (token) {
          const word = token.getAttribute('data-word');
          if (word) {
            // Visual active highlight
            sanskritEl.querySelectorAll('.shloka-word-token').forEach(t => t.classList.remove('active-token'));
            token.classList.add('active-token');

            const rect = token.getBoundingClientRect();
            handleWordLookup(word, token, rect.left + rect.width / 2, rect.bottom + 6);
          }
        }
      });
    }

    // 2. Word Breakdown Cards Click
    const wordBreakdownContainer = document.getElementById('wordBreakdownContent');
    if (wordBreakdownContainer) {
      wordBreakdownContainer.addEventListener('click', (e) => {
        const card = e.target.closest('.interactive-word-card');
        if (card) {
          const word = card.getAttribute('data-word');
          if (word) {
            const rect = card.getBoundingClientRect();
            handleWordLookup(word, card, rect.left + 50, rect.bottom + 6);
          }
        }
      });
    }

    // 3. Vocab Chips in Drawer Click
    if (verseVocabChipsEl) {
      verseVocabChipsEl.addEventListener('click', (e) => {
        const chip = e.target.closest('.vocab-chip');
        if (chip) {
          const word = chip.getAttribute('data-word');
          if (word) {
            displayWordInDrawer(word);
          }
        }
      });
    }

    // 4. Search Results in Drawer Click
    if (dictSearchResultsList) {
      dictSearchResultsList.addEventListener('click', (e) => {
        const item = e.target.closest('.dict-result-item');
        if (item) {
          const word = item.getAttribute('data-word');
          if (word) {
            displayWordInDrawer(word);
          }
        }
      });
    }

    // 5. Example Chips Click
    document.querySelectorAll('.example-chip').forEach(btn => {
      btn.addEventListener('click', () => {
        const term = btn.getAttribute('data-term');
        if (term) {
          if (dictInput) dictInput.value = term;
          if (clearDictInputBtn) clearDictInputBtn.style.display = 'block';
          displayWordInDrawer(term);
        }
      });
    });

    // 6. Drawer Trigger Buttons
    if (openDictDrawerBtn) {
      openDictDrawerBtn.addEventListener('click', () => {
        if (dictDrawer?.classList.contains('open')) {
          closeDictDrawer();
        } else {
          openDictDrawer();
        }
      });
    }

    if (dictToggleBottomBtn) {
      dictToggleBottomBtn.addEventListener('click', () => {
        if (dictDrawer?.classList.contains('open')) {
          closeDictDrawer();
        } else {
          openDictDrawer();
        }
      });
    }

    if (lookupHintBtn) {
      lookupHintBtn.addEventListener('click', () => {
        openDictDrawer();
      });
    }

    if (closeDictDrawerBtn) {
      closeDictDrawerBtn.addEventListener('click', closeDictDrawer);
    }

    // Close drawer when clicking outer backdrop
    if (dictDrawer) {
      dictDrawer.addEventListener('click', (e) => {
        if (e.target === dictDrawer) {
          closeDictDrawer();
        }
      });
    }

    // 7. Popover Handlers
    if (closePopoverBtn && popoverEl) {
      closePopoverBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        popoverEl.style.display = 'none';
        sanskritEl?.querySelectorAll('.shloka-word-token').forEach(t => t.classList.remove('active-token'));
      });
    }

    if (expandInDictDrawerBtn) {
      expandInDictDrawerBtn.addEventListener('click', () => {
        if (popoverCurrentWord) {
          openDictDrawer(popoverCurrentWord);
        } else {
          openDictDrawer();
        }
      });
    }

    // Dismiss popover on outside click
    document.addEventListener('click', (e) => {
      if (popoverEl && popoverEl.style.display !== 'none') {
        if (!popoverEl.contains(e.target) && !e.target.closest('.shloka-word-token') && !e.target.closest('.interactive-word-card') && !e.target.closest('.bhasya-selectable')) {
          popoverEl.style.display = 'none';
          sanskritEl?.querySelectorAll('.shloka-word-token').forEach(t => t.classList.remove('active-token'));
        }
      }
    });

    // 8. Text Selection in Commentary
    function handleCommentarySelection(e) {
      const selection = window.getSelection();
      const selectedText = (selection ? selection.toString() : '').trim();
      if (!selectedText || selectedText.length > 40) return;
      if (!/[\u0900-\u097F]/.test(selectedText)) return;

      const cleanWord = selectedText.split(/\s+/)[0].replace(/[\s\u0964\u0965\.\,\-\:\;\|\!\?\'\"0-9०-९\(\)]/g, '');
      if (!cleanWord) return;

      const clientX = e.clientX || (e.touches && e.touches[0] ? e.touches[0].clientX : 200);
      const clientY = e.clientY || (e.touches && e.touches[0] ? e.touches[0].clientY : 200);

      handleWordLookup(cleanWord, null, clientX, clientY);
    }

    document.addEventListener('mouseup', (e) => {
      if (e.target && e.target.closest('.bhasya-selectable')) {
        setTimeout(() => handleCommentarySelection(e), 50);
      }
    });

    document.addEventListener('touchend', (e) => {
      if (e.target && e.target.closest('.bhasya-selectable')) {
        setTimeout(() => {
          const touch = e.changedTouches ? e.changedTouches[0] : e;
          handleCommentarySelection(touch);
        }, 150);
      }
    });

    // 9. Live Search Input Debounce
    if (dictInput) {
      dictInput.addEventListener('input', (e) => {
        const val = e.target.value;
        if (clearDictInputBtn) {
          clearDictInputBtn.style.display = val ? 'block' : 'none';
        }

        clearTimeout(searchDebounceTimer);
        searchDebounceTimer = setTimeout(async () => {
          const q = val.trim();
          if (!q) {
            if (dictActiveEntryCard) dictActiveEntryCard.style.display = 'none';
            if (dictSearchResultsList) dictSearchResultsList.style.display = 'none';
            if (dictEmptyState) dictEmptyState.style.display = 'block';
            return;
          }

          const results = await searchWords(q);
          renderSearchResults(results, `Search results for "${q}":`);
        }, 220);
      });
    }

    if (clearDictInputBtn) {
      clearDictInputBtn.addEventListener('click', () => {
        if (dictInput) {
          dictInput.value = '';
          dictInput.focus();
        }
        clearDictInputBtn.style.display = 'none';
        if (dictActiveEntryCard) dictActiveEntryCard.style.display = 'none';
        if (dictSearchResultsList) dictSearchResultsList.style.display = 'none';
        if (dictEmptyState) dictEmptyState.style.display = 'block';
      });
    }

    // 10. Scope Filter Buttons
    dictScopePills.forEach(pill => {
      pill.addEventListener('click', () => {
        dictScopePills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        activeDictScope = pill.getAttribute('data-scope') || 'all';

        if (dictInput && dictInput.value.trim()) {
          displayWordInDrawer(dictInput.value.trim());
        }
      });
    });

    // 11. Keyboard Shortcuts (Escape to close, 'd' to toggle drawer)
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (dictDrawer?.classList.contains('open')) closeDictDrawer();
        if (popoverEl && popoverEl.style.display !== 'none') popoverEl.style.display = 'none';
      } else if ((e.key === 'd' || e.key === 'D') && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName)) {
        if (dictDrawer?.classList.contains('open')) {
          closeDictDrawer();
        } else {
          openDictDrawer();
        }
      }
    });

  })();

</script>
