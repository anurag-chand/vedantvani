---
import type { Scripture } from '../data/scriptures';

interface Props {
  scripture: Scripture;
  initialChapter?: number;
  initialVerse?: number;
}

const { scripture, initialChapter = 1, initialVerse = 1 } = Astro.props;
---

<div class="verse-reader-root" id="verseReaderApp" data-scripture-id={scripture.id}>
  <div class="reader-container">
    
    <!-- Reader Sub-Header / Control Strip -->
    <div class="reader-sub-header">
      <div class="reader-header-left">
        <a href={`/read/${scripture.id}`} class="scripture-badge-link">
          <span class="scripture-mini-icon">📜</span>
          <span class="scripture-mini-title">{scripture.name}</span>
        </a>
        <div class="chapter-badge font-cinzel" id="activeChapterTitle">
          Chapter {initialChapter}
        </div>
      </div>

      <div class="reader-header-right">
        <!-- On-Screen Dictionary Lookup Trigger Button -->
        <button id="openDictDrawerBtn" class="drawer-trigger-btn font-cinzel dict-trigger-accent" aria-label="Open On-Screen Dictionary Lookup" title="On-Screen Dictionary Lookup (132,466 terms: Śāṅkara Bhāṣya & Mūla)">
          <span>📖</span>
          <span>Dictionary</span>
        </button>

        <!-- Drawer Trigger Button -->
        <button id="openDrawerBtn" class="drawer-trigger-btn" aria-label="Open Chapter and Verse Navigator">
          <span>📑</span>
          <span>Verses</span>
        </button>

        <!-- Font Resizer Controls -->
        <div class="font-controls">
          <button id="decFontBtn" class="font-ctrl-btn" aria-label="Decrease Font Size" title="Smaller font">A−</button>
          <button id="incFontBtn" class="font-ctrl-btn" aria-label="Increase Font Size" title="Larger font">A+</button>
        </div>

        <!-- Copy Verse Button -->
        <button id="copyVerseBtn" class="action-btn-sm" aria-label="Copy Verse Text" title="Copy formatted verse">
          <span>📋</span>
        </button>
      </div>
    </div>

    <!-- Chapter Summary Card (Collapsible) -->
    <details class="chapter-summary-details" id="chapterSummaryAccordion">
      <summary class="summary-toggle-bar">
        <span class="summary-label font-cinzel">
          <span id="summaryChapterName">Chapter Summary</span>
          <span class="summary-sanskrit font-devanagari" id="summaryChapterSanskrit"></span>
        </span>
        <span class="summary-arrow">▾</span>
      </summary>
      <div class="summary-content font-lora" id="summaryChapterText">
        Loading chapter description...
      </div>
    </details>

    <!-- Main Shloka Presentation Box -->
    <div class="shloka-box" id="shlokaBox">
      <div class="shloka-coord-strip">
        <span class="coord-pill font-cinzel" id="verseCoordLabel">
          Chapter {initialChapter} • Verse {initialVerse}
        </span>
        <span class="meta-section-pill font-cinzel" id="verseSectionTag" style="display: none;"></span>
        <span class="meta-stage-pill font-cinzel" id="verseStageTag" style="display: none;"></span>
        <button id="lookupHintBtn" class="lookup-hint-pill font-cinzel" title="Click any Sanskrit word to inspect root, grammar and definition">
          <span>💡</span> Tap word for dictionary
        </button>
      </div>

      <div class="shloka-sanskrit font-devanagari" id="sanskritText">
        Loading Sanskrit text...
      </div>

      <div class="shloka-transliteration font-lora" id="transliterationText">
        Loading transliteration...
      </div>

      <!-- Contemplation Summary Line (when summary_line is available) -->
      <div class="verse-contemplation-banner font-lora" id="verseSummaryLine" style="display: none;">
        <div class="contemplation-text" id="verseSummaryText"></div>
      </div>

      <!-- Philosophical Metadata Chips Strip -->
      <div class="verse-meta-strip" id="verseMetaStrip" style="display: none;"></div>

      <!-- Audio Chanting Recitation Bar (when audio_link is available) -->
      <div class="audio-chanting-bar" id="audioChantingBar" style="display: none;">
        <button id="playAudioBtn" class="audio-play-btn" aria-label="Listen to Chanting Recitation">
          <span id="audioPlayIcon">🔊</span>
          <span id="audioPlayText">Play Sacred Recitation</span>
        </button>
        <audio id="sutraAudioEl" preload="none"></audio>
      </div>
    </div>

    <!-- Reader Tabs (Translations, Commentaries, Word Breakdown, Insights & Inquiries) -->
    <div class="reader-tabs" role="tablist">
      <button class="tab-btn active" data-tab="translations" role="tab" id="tabBtnTranslations">
        Translations
      </button>
      <button class="tab-btn" data-tab="commentaries" role="tab" id="tabBtnCommentaries">
        Commentaries
      </button>
      <button class="tab-btn" data-tab="wordBreakdown" role="tab" id="tabBtnWords">
        Word Breakdown
      </button>
      <button class="tab-btn" data-tab="faqs" role="tab" id="tabBtnFaqs">
        Insights & Inquiries
      </button>
    </div>

    <!-- Tab Panels Container -->
    <div class="tab-panels-wrapper">
      
      <!-- Panel 1: Translations -->
      <section class="tab-panel active" id="panelTranslations" role="tabpanel">
        <div id="translationsList" class="interpretations-stream">
          <!-- Populated dynamically -->
        </div>
      </section>

      <!-- Panel 2: Commentaries -->
      <section class="tab-panel" id="panelCommentaries" role="tabpanel">
        <div class="school-filter-bar" id="schoolFilterBar">
          <button class="school-chip active" data-school="all">All Commentaries</button>
          {scripture.id === 'yogasutras' ? (
            <>
              <button class="school-chip" data-school="Vyasa">Vyāsa Bhāṣya</button>
              <button class="school-chip" data-school="Bhoja">Rājāmārtāṇḍa</button>
              <button class="school-chip" data-school="Vacaspati">Tattva Vaiśāradī</button>
              <button class="school-chip" data-school="Sarasvati">Yoga Sudhākara</button>
              <button class="school-chip" data-school="Hindi">Hindi Bhāṣyas</button>
            </>
          ) : (
            <>
              <button class="school-chip" data-school="Advaita">Advaita</button>
              <button class="school-chip" data-school="Vishishtadvaita">Viśiṣṭādvaita</button>
              <button class="school-chip" data-school="Dvaita">Dvaita</button>
              <button class="school-chip" data-school="Suddhadvaita">Śuddhādvaita</button>
            </>
          )}
        </div>
        <div id="commentariesList" class="interpretations-stream">
          <!-- Populated dynamically -->
        </div>
      </section>

      <!-- Panel 3: Word Breakdown -->
      <section class="tab-panel" id="panelWordBreakdown" role="tabpanel">
        <div id="wordBreakdownContent" class="word-breakdown-grid">
          <!-- Populated dynamically -->
        </div>
      </section>

      <!-- Panel 4: Inquiries & Philosophical Insights -->
      <section class="tab-panel" id="panelFaqs" role="tabpanel">
        <div id="metadataOverviewCard" class="metadata-overview-card" style="display: none;"></div>
        <div id="faqsList" class="faqs-stream">
          <!-- Populated dynamically -->
        </div>
      </section>

    </div>

  </div>

  <!-- Mobile Bottom Floating Navigation -->
  <div class="reader-bottom-controls" id="readerBottomControls">
    <button id="prevVerseBtn" class="reader-control-btn" aria-label="Previous Verse">
      <span>◀</span>
      <span class="btn-text">Prev</span>
    </button>

    <button id="dictToggleBottomBtn" class="reader-control-btn" aria-label="Open On-Screen Dictionary">
      <span>📖</span>
      <span class="btn-text">Dict</span>
    </button>

    <button id="drawerToggleBottomBtn" class="reader-control-btn primary" aria-label="Select Chapter and Verse">
      <span>📑</span>
      <span id="verseIndicatorBottom">Ch 1 : V 1</span>
    </button>

    <button id="nextVerseBtn" class="reader-control-btn" aria-label="Next Verse">
      <span class="btn-text">Next</span>
      <span>▶</span>
    </button>
  </div>

  <!-- Chapter & Verse Selector Drawer / Bottom Sheet -->
  <div id="chapterVerseDrawer" class="drawer-backdrop" aria-hidden="true">
    <div class="drawer-content">
      <div class="drawer-header">
        <div>
          <h3 class="font-cinzel" style="font-size: 1.1rem; color: var(--text-primary);">Select Chapter & Verse</h3>
          <span style="font-size: 0.75rem; color: var(--saffron);">{scripture.name}</span>
        </div>
        <button id="closeDrawerBtn" class="action-btn-sm" aria-label="Close Navigator">✕</button>
      </div>

      <div class="drawer-body">
        <!-- Chapter Dropdown -->
        <div class="drawer-field">
          <label for="drawerChapterSelect" class="drawer-label font-cinzel">Chapter / Section</label>
          <select id="drawerChapterSelect" class="drawer-select font-sans">
            {scripture.chapters.map((ch) => (
              <option value={ch.chapter_number} selected={ch.chapter_number === initialChapter}>
                {ch.chapter_number}. {ch.name} {ch.name_sanskrit ? `(${ch.name_sanskrit})` : ''} - {ch.verses_count} Verses
              </option>
            ))}
          </select>
        </div>

        <!-- Verses Grid Title -->
        <div class="drawer-field" style="margin-top: 1.25rem;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <label class="drawer-label font-cinzel">Verses in Chapter</label>
            <span id="drawerVerseTotal" style="font-size: 0.75rem; color: var(--text-muted);">
              {scripture.chapters[0]?.verses_count || 0} Verses
            </span>
          </div>

          <div class="verse-grid" id="drawerVerseGrid">
            <!-- Programmatically populated buttons -->
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- On-Screen Dictionary Slide Drawer / Panel -->
  <div id="onScreenDictDrawer" class="dict-drawer-backdrop" aria-hidden="true">
    <div class="dict-drawer-panel">
      <!-- Panel Header -->
      <div class="dict-drawer-header">
        <div class="dict-drawer-title-group">
          <div class="dict-drawer-heading font-cinzel">
            <span class="dict-header-icon">📖</span>
            <span>Prasthānatrayī Lexicon</span>
          </div>
          <div class="dict-drawer-subheading font-cinzel">
            132,466 Terms • Śāṅkara Bhāṣya & Mūla
          </div>
        </div>
        <div class="dict-drawer-actions">
          <a href="/bhashya-dictionary" target="_blank" class="dict-full-link font-cinzel" title="Open full Lexicon Explorer in new tab">
            <span>Explorer</span> ↗
          </a>
          <button id="closeDictDrawerBtn" class="action-btn-sm" aria-label="Close Dictionary">✕</button>
        </div>
      </div>

      <!-- Live Search & Scope Bar -->
      <div class="dict-drawer-search-area">
        <div class="dict-search-field">
          <span class="dict-search-icon">🔍</span>
          <input 
            type="text" 
            id="onScreenDictInput" 
            class="dict-search-input font-devanagari" 
            placeholder="Search Sanskrit or English (e.g. brahman, अविद्या)..."
            autocomplete="off"
            spellcheck="false"
          />
          <button id="clearDictInputBtn" class="dict-clear-btn" aria-label="Clear search" style="display: none;">✕</button>
        </div>
        
        <div class="dict-scope-pills" id="dictScopePills">
          <button class="dict-scope-btn active" data-scope="all">All (132k)</button>
          <button class="dict-scope-btn" data-scope="mula">Mūla (36k)</button>
          <button class="dict-scope-btn" data-scope="bhasya">Bhāṣya (95k)</button>
        </div>
      </div>

      <!-- Current Verse Vocabulary Strip -->
      <div class="dict-vocab-section">
        <div class="dict-vocab-heading font-cinzel">
          <span>Words in this Verse / Sūtra</span>
          <span class="vocab-badge" id="vocabCountBadge">0 words</span>
        </div>
        <div class="dict-vocab-chips" id="verseVocabChips">
          <!-- Populated dynamically with chips for words in current verse -->
        </div>
      </div>

      <!-- Main Display Area: Active Word or Search Results -->
      <div class="dict-content-scroll" id="dictContentScroll">
        <!-- Card for Selected Word -->
        <div id="dictActiveEntryCard" class="dict-active-card" style="display: none;">
          <!-- Populated when a word is active -->
        </div>

        <!-- Search Results List -->
        <div id="dictSearchResultsList" class="dict-results-list" style="display: none;">
          <!-- Populated when typing a search query -->
        </div>

        <!-- Initial Placeholder State -->
        <div id="dictEmptyState" class="dict-empty-state">
          <div class="empty-icon">🕉️</div>
          <h4 class="font-cinzel">On-Screen Lexicon Ready</h4>
          <p class="font-lora">
            Tap any Sanskrit word in the sacred verse, word-by-word breakdown, or commentary to view its exact root (dhātu/prātipadika), grammatical case (vibhakti/lakāra), and philosophical exposition.
          </p>
          <div class="dict-quick-examples">
            <span class="examples-label font-cinzel">Quick examples:</span>
            <button class="example-chip font-devanagari" data-term="ब्रह्म">ब्रह्म</button>
            <button class="example-chip font-devanagari" data-term="अविद्या">अविद्या</button>
            <button class="example-chip font-devanagari" data-term="आनन्द">आनन्द</button>
            <button class="example-chip font-devanagari" data-term="माया">माया</button>
            <button class="example-chip font-devanagari" data-term="अध्यास">अध्यास</button>
          </div>
        </div>
      </div>

      <!-- Footer Edge Connection Status -->
      <div class="dict-panel-footer">
        <span class="edge-dot"></span>
        <span class="edge-text font-cinzel" id="dictEdgeStatusLabel">Cloudflare Edge D1 API • 132,466 terms</span>
      </div>
    </div>
  </div>

  <!-- Floating Morphological Lexicon Popover for Quick In-Place Lookup -->
  <div id="bhasyaWordPopover" class="bhasya-word-popover" style="display: none;" role="tooltip">
    <div class="popover-header">
      <div class="popover-title-row">
        <span class="popover-surface font-devanagari" id="popoverSurface"></span>
        <span class="popover-source-tag font-cinzel" id="popoverSourceTag" style="display: none;"></span>
      </div>
      <button id="closePopoverBtn" class="popover-close" aria-label="Close popover">✕</button>
    </div>
    <div class="popover-padaccheda font-devanagari" id="popoverPadaccheda"></div>
    <div class="popover-grammar" id="popoverGrammar"></div>
    <div class="popover-meaning font-lora" id="popoverMeaning"></div>
    <div class="popover-footer">
      <button id="expandInDictDrawerBtn" class="popover-expand-btn font-cinzel">Open in Panel ↗</button>
      <a id="popoverFullLink" href="/bhashya-dictionary" target="_blank" class="popover-link font-cinzel">Full Explorer</a>
    </div>
  </div>

</div>

<style>
  .verse-reader-root {
    width: 100%;
    position: relative;
    padding-bottom: 5.5rem;
  }

  .reader-header-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .scripture-badge-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--saffron);
    background: var(--saffron-subtle);
    border: 1px solid var(--border-subtle);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .scripture-badge-link:hover {
    border-color: var(--saffron);
  }

  .chapter-badge {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: 0.05em;
  }

  .reader-header-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .drawer-trigger-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-md);
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    font-size: 0.8rem;
    font-weight: 600;
    transition: all var(--transition-fast);
  }

  .drawer-trigger-btn:hover {
    border-color: var(--saffron);
    color: var(--saffron);
  }

  .font-controls {
    display: flex;
    align-items: center;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .font-ctrl-btn {
    padding: 0.35rem 0.65rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-secondary);
    transition: background 0.15s ease, color 0.15s ease;
  }

  .font-ctrl-btn:hover {
    background: var(--bg-surface);
    color: var(--saffron);
  }

  .action-btn-sm {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-md);
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    font-size: 0.85rem;
    transition: all var(--transition-fast);
  }

  .action-btn-sm:hover {
    border-color: var(--saffron);
    color: var(--saffron);
  }

  /* Audio Chanting Bar */
  .audio-chanting-bar {
    display: flex;
    justify-content: center;
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--border-subtle);
  }

  .audio-play-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 1rem;
    border-radius: var(--radius-pill);
    background: var(--gold-subtle);
    border: 1px solid var(--gold);
    color: var(--gold);
    font-size: 0.82rem;
    font-weight: 600;
    transition: all var(--transition-fast);
  }

  .audio-play-btn:hover {
    background: var(--gold);
    color: #080a0f;
    box-shadow: 0 0 12px var(--gold-glow);
  }

  /* Chapter Summary Accordion */
  .chapter-summary-details {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    margin-bottom: 1.25rem;
    overflow: hidden;
    transition: border-color var(--transition-fast);
  }

  .summary-toggle-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 600;
    list-style: none;
    user-select: none;
  }

  .summary-toggle-bar::-webkit-details-marker {
    display: none;
  }

  .summary-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-primary);
  }

  .summary-sanskrit {
    color: var(--gold);
    font-size: 0.9rem;
  }

  .summary-arrow {
    color: var(--saffron);
    transition: transform var(--transition-fast);
  }

  .chapter-summary-details[open] .summary-arrow {
    transform: rotate(180deg);
  }

  .summary-content {
    padding: 0.5rem 1rem 1rem 1rem;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-secondary);
    border-top: 1px dashed var(--border-subtle);
  }

  .shloka-coord-strip {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .coord-pill {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--saffron);
    background: var(--saffron-subtle);
    border: 1px solid var(--border-subtle);
    padding: 0.25rem 0.85rem;
    border-radius: var(--radius-pill);
  }

  .meta-section-pill {
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--accent-gold);
    background: rgba(212, 175, 55, 0.08);
    border: 1px solid rgba(212, 175, 55, 0.3);
    padding: 0.25rem 0.85rem;
    border-radius: var(--radius-pill);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    max-width: 90%;
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
  }

  .meta-stage-pill {
    font-size: 0.74rem;
    font-weight: 600;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.3);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  /* Contemplation Banner */
  .verse-contemplation-banner {
    margin-top: 1.25rem;
    padding: 0.75rem 1.25rem;
    background: rgba(212, 175, 55, 0.04);
    border-left: 3px solid var(--accent-gold);
    border-radius: 2px var(--radius-md) var(--radius-md) 2px;
    text-align: left;
    transition: all var(--transition-fast);
  }

  .contemplation-text {
    font-size: 0.95rem;
    font-style: italic;
    line-height: 1.6;
    color: var(--text-primary);
    opacity: 0.95;
  }

  /* Meta Chips Strip in Shloka Box */
  .verse-meta-strip {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--border-subtle);
  }

  .meta-chip {
    display: inline-flex;
    align-items: center;
    font-size: 0.72rem;
    font-weight: 500;
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-pill);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    letter-spacing: 0.02em;
    transition: all var(--transition-fast);
  }

  .meta-chip.doctrine {
    color: var(--accent-gold);
    border-color: rgba(212, 175, 55, 0.35);
    background: rgba(212, 175, 55, 0.05);
  }

  .meta-chip.prakriya {
    color: #818cf8;
    border-color: rgba(129, 140, 248, 0.35);
    background: rgba(129, 140, 248, 0.05);
  }

  .meta-chip.stage {
    color: #38bdf8;
    border-color: rgba(56, 189, 248, 0.35);
    background: rgba(56, 189, 248, 0.05);
  }

  .meta-chip.obstacle {
    color: #f87171;
    border-color: rgba(248, 113, 113, 0.35);
    background: rgba(248, 113, 113, 0.05);
  }

  .meta-chip.keyword {
    color: #34d399;
    border-color: rgba(52, 211, 153, 0.35);
    background: rgba(52, 211, 153, 0.05);
  }

  /* Metadata Overview Card in Insights Panel */
  .metadata-overview-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    margin-bottom: 1.25rem;
    box-shadow: var(--shadow-sm);
  }

  .meta-overview-header {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-gold);
