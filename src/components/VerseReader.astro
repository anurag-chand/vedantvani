    const chapterCache = {};

    let activeSchool = 'all';
    let fontSizeScale = parseFloat(localStorage.getItem('vv_font_scale') || '1.0');

    // Vedantic school & commentator mapping
    const schoolMap = {
      'Sri Shankaracharya': 'Advaita',
      'Adi Shankaracharya': 'Advaita',
      'Sri Madhusudan Saraswati': 'Advaita',
      'Sri Anandgiri': 'Advaita',
      'Sri Ramanujacharya': 'Vishishtadvaita',
      'Sri Vedantadeshikacharya Venkatanatha': 'Vishishtadvaita',
      'Swami Adidevananda': 'Vishishtadvaita',
      'Sri Madhavacharya': 'Dvaita',
      'Sri Jayatritha': 'Dvaita',
      'Sri Sridhara Swami': 'Suddhadvaita',
      'Sri Vallabhacharya': 'Suddhadvaita',
      'Sri Purushottamji': 'Suddhadvaita',
      'Sri Abhinavgupta': 'Kashmir Shaivism',
      'Swami Sivananda': 'Modern Vedanta',
      'Swami Chinmayananda': 'Modern Vedanta',
      'Swami Gambirananda': 'Advaita',
      'Swami Ramsukhdas': 'Bhakti / Karma',
      'Adi Shankaracharya Bhashya': 'Advaita',
      'Adi Shankaracharya (Pada Bhashya)': 'Advaita',
      'Adi Shankaracharya (Vakya Bhashya)': 'Advaita',
      // Yoga Sutra Commentaries
      'Vyāsa Bhāṣya (Maharshi Vyāsa)': 'Yoga Darśana',
      'Vyāsa Bhāṣya (Hindi Translation)': 'Yoga Darśana (Hindi)',
      'Rājāmārtāṇḍa (King Bhojadeva)': 'Yoga Darśana (Bhoja)',
      'Rājāmārtāṇḍa (Hindi Translation)': 'Yoga Darśana (Hindi)',
      'Tattva Vaiśāradī (Vācaspati Miśra)': 'Classical Yoga (Vācaspati)',
      'Tattva Vaiśāradī (Hindi Translation)': 'Classical Yoga (Hindi)',
      'Yoga Sudhākara (Sadāśivendra Sarasvatī)': 'Yoga Sudhākara',
      'Yoga Sudhākara (Hindi Translation)': 'Yoga Sudhākara (Hindi)'
    };

    // DOM Elements
    const sanskritEl = document.getElementById('sanskritText');
    const translitEl = document.getElementById('transliterationText');
    const coordLabel = document.getElementById('verseCoordLabel');
    const bottomIndicator = document.getElementById('verseIndicatorBottom');
    const prevBtn = document.getElementById('prevVerseBtn');
    const nextBtn = document.getElementById('nextVerseBtn');
    const copyBtn = document.getElementById('copyVerseBtn');
    const decFont = document.getElementById('decFontBtn');
    const incFont = document.getElementById('incFontBtn');
    const shlokaBox = document.getElementById('shlokaBox');

    // Audio elements
    const audioBar = document.getElementById('audioChantingBar');
    const playAudioBtn = document.getElementById('playAudioBtn');
    const audioPlayIcon = document.getElementById('audioPlayIcon');
    const audioPlayText = document.getElementById('audioPlayText');
    const audioEl = document.getElementById('sutraAudioEl');

    // Summary Elements
    const summaryTitle = document.getElementById('summaryChapterName');
    const summarySanskrit = document.getElementById('summaryChapterSanskrit');
    const summaryText = document.getElementById('summaryChapterText');
    const activeChTitle = document.getElementById('activeChapterTitle');

    // Tabs
    const tabButtons = document.querySelectorAll('.tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');

    // Drawer Elements
    const drawer = document.getElementById('chapterVerseDrawer');
    const openDrawerBtn = document.getElementById('openDrawerBtn');
    const drawerToggleBottomBtn = document.getElementById('drawerToggleBottomBtn');
    const closeDrawerBtn = document.getElementById('closeDrawerBtn');
    const drawerChSelect = document.getElementById('drawerChapterSelect');
    const drawerVerseGrid = document.getElementById('drawerVerseGrid');
    const drawerVerseTotal = document.getElementById('drawerVerseTotal');

    // Check URL parameters on load
    const params = new URLSearchParams(window.location.search);
    const qC = parseInt(params.get('c'), 10);
    const qV = parseInt(params.get('v'), 10);
    if (!isNaN(qC) && chaptersMeta.some(ch => ch.chapter_number === qC)) {
      currentChapter = qC;
    }
    if (!isNaN(qV) && qV > 0) {
      currentVerse = qV;
    }

    applyFontSize();

    // Event Listeners
    if (openDrawerBtn) openDrawerBtn.addEventListener('click', openDrawer);
    if (drawerToggleBottomBtn) drawerToggleBottomBtn.addEventListener('click', openDrawer);
    if (closeDrawerBtn) closeDrawerBtn.addEventListener('click', closeDrawer);

    if (drawer) {
      drawer.addEventListener('click', (e) => {
        if (e.target === drawer) closeDrawer();
      });
    }

    if (drawerChSelect) {
      drawerChSelect.addEventListener('change', (e) => {
        const newCh = parseInt(e.target.value, 10);
        switchChapter(newCh, 1);
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        if (currentVerse > 1) {
          switchVerse(currentVerse - 1);
        } else if (currentChapter > 1) {
          const prevChMeta = chaptersMeta.find(c => c.chapter_number === currentChapter - 1);
          const targetVerse = prevChMeta ? prevChMeta.verses_count : 1;
          switchChapter(currentChapter - 1, targetVerse);
        }
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        const chMeta = chaptersMeta.find(c => c.chapter_number === currentChapter);
        const maxV = chMeta ? chMeta.verses_count : currentVersesData.length;
        if (currentVerse < maxV) {
          switchVerse(currentVerse + 1);
        } else if (currentChapter < chaptersMeta.length) {
          switchChapter(currentChapter + 1, 1);
        }
      });
    }

    // Audio Playback Handler
    if (playAudioBtn && audioEl) {
      playAudioBtn.addEventListener('click', () => {
        if (audioEl.paused) {
          audioEl.play().then(() => {
            if (audioPlayIcon) audioPlayIcon.textContent = '⏸';
            if (audioPlayText) audioPlayText.textContent = 'Pause Recitation';
          }).catch(err => {
            console.warn('Playback error:', err);
          });
        } else {
          audioEl.pause();
          if (audioPlayIcon) audioPlayIcon.textContent = '🔊';
          if (audioPlayText) audioPlayText.textContent = 'Play Sacred Recitation';
        }
      });

      audioEl.addEventListener('ended', () => {
        if (audioPlayIcon) audioPlayIcon.textContent = '🔊';
        if (audioPlayText) audioPlayText.textContent = 'Play Sacred Recitation';
      });
    }

    // Keyboard Shortcuts (ArrowLeft, ArrowRight)
    window.addEventListener('keydown', (e) => {
      if (document.activeElement?.tagName === 'INPUT' || document.activeElement?.tagName === 'SELECT' || document.activeElement?.tagName === 'TEXTAREA') {
        return;
      }
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        prevBtn?.click();
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        nextBtn?.click();
      }
    });

    // Font Controls
    if (decFont) {
      decFont.addEventListener('click', () => {
        fontSizeScale = Math.max(0.8, fontSizeScale - 0.1);
        localStorage.setItem('vv_font_scale', fontSizeScale.toFixed(2));
        applyFontSize();
      });
    }
    if (incFont) {
      incFont.addEventListener('click', () => {
        fontSizeScale = Math.min(1.5, fontSizeScale + 0.1);
        localStorage.setItem('vv_font_scale', fontSizeScale.toFixed(2));
        applyFontSize();
      });
    }

    // Copy Verse
    if (copyBtn) {
      copyBtn.addEventListener('click', copyVerse);
    }

    // Tabs
    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetTab = btn.getAttribute('data-tab');
        tabButtons.forEach(b => b.classList.remove('active'));
        tabPanels.forEach(p => p.classList.remove('active'));

        btn.classList.add('active');
        const panel = document.getElementById(`panel${targetTab.charAt(0).toUpperCase() + targetTab.slice(1)}`);
        if (panel) panel.classList.add('active');
      });
    });

    // School filter in commentaries
    const schoolChips = document.querySelectorAll('.school-chip');
    schoolChips.forEach(chip => {
      chip.addEventListener('click', () => {
        schoolChips.forEach(c => c.classList.remove('active'));
        chip.classList.add('active');
        activeSchool = chip.getAttribute('data-school') || 'all';
        renderCommentaries();
      });
    });

    // Initialize
    loadChapter(currentChapter, currentVerse);

    // Core Data Fetcher
    async function loadChapter(chNumber, targetVerse = 1) {
      currentChapter = chNumber;
      updateChapterMetaView();

      if (chapterCache[chNumber]) {
        currentVersesData = chapterCache[chNumber];
        renderVerseGrid();
        switchVerse(targetVerse);
        return;
      }

      sanskritEl.textContent = 'Loading sacred verse...';
      translitEl.textContent = 'Fetching data...';

      try {
        const res = await fetch(`/data/${scriptureId}/chapters/chapter_${chNumber}.json`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        chapterCache[chNumber] = data;
        currentVersesData = data;
        renderVerseGrid();
        switchVerse(targetVerse);
      } catch (err) {
        console.error('Error loading chapter:', err);
        sanskritEl.textContent = 'Error loading scripture text.';
        translitEl.textContent = 'Please check connection or select another chapter.';
      }
    }

    function switchChapter(newCh, targetVerse = 1) {
      if (drawerChSelect) drawerChSelect.value = newCh;
      loadChapter(newCh, targetVerse);
    }

    function switchVerse(vNumber) {
      const chMeta = chaptersMeta.find(c => c.chapter_number === currentChapter);
      const maxV = chMeta ? chMeta.verses_count : currentVersesData.length;
      currentVerse = Math.min(Math.max(1, vNumber), maxV || 1);

      updateUrl();
      renderCurrentVerse();
      updateNavigationButtons();
      updateDrawerActiveVerse();
    }

    function updateUrl() {
      const url = new URL(window.location.href);
      url.searchParams.set('c', currentChapter);
      url.searchParams.set('v', currentVerse);
      window.history.replaceState({}, '', url.toString());
    }

    function updateChapterMetaView() {
      const ch = chaptersMeta.find(c => c.chapter_number === currentChapter) || chaptersMeta[0];
      if (summaryTitle) summaryTitle.textContent = `${ch.chapter_number}. ${ch.name}`;
      if (summarySanskrit) summarySanskrit.textContent = ch.name_sanskrit ? `(${ch.name_sanskrit})` : '';
      if (summaryText) summaryText.textContent = ch.summary || 'Summary for this sacred chapter.';
      if (activeChTitle) activeChTitle.textContent = `Ch ${ch.chapter_number}: ${ch.name}`;
      if (drawerVerseTotal) drawerVerseTotal.textContent = `${ch.verses_count} Verses`;
    }

    function renderVerseGrid() {
      if (!drawerVerseGrid) return;
      const ch = chaptersMeta.find(c => c.chapter_number === currentChapter);
      const total = ch ? ch.verses_count : currentVersesData.length;

      let html = '';
      for (let i = 1; i <= total; i++) {
        const vObj = currentVersesData[i - 1];
        const displayNum = (vObj && vObj.sutra_number) ? vObj.sutra_number : i;
        html += `<button class="verse-btn ${i === currentVerse ? 'active' : ''}" data-verse="${i}">${displayNum}</button>`;
      }
      drawerVerseGrid.innerHTML = html;

      drawerVerseGrid.querySelectorAll('.verse-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const v = parseInt(btn.getAttribute('data-verse'), 10);
          switchVerse(v);
          closeDrawer();
        });
      });
    }

    function updateDrawerActiveVerse() {
      drawerVerseGrid?.querySelectorAll('.verse-btn').forEach(btn => {
        const v = parseInt(btn.getAttribute('data-verse'), 10);
        btn.classList.toggle('active', v === currentVerse);
      });
    }

    function renderCurrentVerse() {
      const verseObj = currentVersesData[currentVerse - 1] || currentVersesData[0];
      if (!verseObj) return;

      const sanskrit = verseObj.sanskrit_shloka || verseObj.text || '';
      const translit = verseObj.transliteration || '';

      sanskritEl.innerHTML = formatSanskritTokens(sanskrit);
      translitEl.textContent = translit;
      translitEl.style.display = translit ? 'block' : 'none';

      updateVerseVocabChips(verseObj);

      // Coordinate Label
      const sutraNum = verseObj.sutra_number || currentVerse;
      const term = scriptureId === 'yogasutras' ? 'Sūtra' : 'Verse';
      const label = `Chapter ${currentChapter} • ${term} ${sutraNum}`;
      if (coordLabel) coordLabel.textContent = label;
      if (bottomIndicator) bottomIndicator.textContent = `Ch ${currentChapter} : ${term[0]} ${sutraNum}`;

      // Metadata elements
      const secTagEl = document.getElementById('verseSectionTag');
      const stageTagEl = document.getElementById('verseStageTag');
      const summaryBannerEl = document.getElementById('verseSummaryLine');
      const summaryTextEl = document.getElementById('verseSummaryText');
      const metaStripEl = document.getElementById('verseMetaStrip');

      const meta = verseObj.metadata || {};
      const secTitle = verseObj.section_title || meta.section_title || '';
      const summaryLine = verseObj.summary_line || meta.summary_line || '';
      const stage = verseObj.sadhana_stage || meta.sadhana_stage || '';
      const doctrine = verseObj.primary_doctrine || meta.primary_doctrine || '';
      const prakriya = verseObj.prakriya_mapped || meta.prakriya_mapped || '';
      const obstacle = verseObj.target_obstacle || meta.target_obstacle || '';
      const category = meta.metaphysical_category || '';
      const keywords = verseObj.keywords_sanskrit || meta.keywords_sanskrit || [];

      // Section Tag Pill
      if (secTagEl) {
        if (secTitle) {
          secTagEl.textContent = secTitle;
          secTagEl.style.display = 'inline-flex';
        } else {
          secTagEl.style.display = 'none';
        }
      }

      // Sādhana Stage Pill
      if (stageTagEl) {
        if (stage) {
          stageTagEl.textContent = `Stage: ${stage}`;
          stageTagEl.style.display = 'inline-flex';
        } else {
          stageTagEl.style.display = 'none';
        }
      }

      // Contemplation Summary Line
      if (summaryBannerEl && summaryTextEl) {
        if (summaryLine) {
          summaryTextEl.textContent = `"${summaryLine}"`;
          summaryBannerEl.style.display = 'block';
        } else {
          summaryBannerEl.style.display = 'none';
        }
      }

      // Meta Chips Strip in Shloka Box
      if (metaStripEl) {
        const chips = [];
        if (doctrine) chips.push(`<span class="meta-chip doctrine" title="Advaita Doctrine">Doctrine: ${doctrine}</span>`);
        if (prakriya && prakriya !== 'None') chips.push(`<span class="meta-chip prakriya" title="Teaching Methodology">Method: ${prakriya}</span>`);
        if (category) chips.push(`<span class="meta-chip category" title="Metaphysical Sphere">Sphere: ${category}</span>`);
        if (obstacle) chips.push(`<span class="meta-chip obstacle" title="Target Obstacle Dismantled">Dismantles: ${obstacle}</span>`);
        if (Array.isArray(keywords)) {
          keywords.slice(0, 4).forEach(kw => {
            chips.push(`<span class="meta-chip keyword">${kw}</span>`);
          });
        }
        if (chips.length > 0) {
          metaStripEl.innerHTML = chips.join('');
          metaStripEl.style.display = 'flex';
        } else {
          metaStripEl.style.display = 'none';
        }
      }

      // Audio handler
      if (audioBar && audioEl) {
        if (verseObj.audio_link) {
          audioBar.style.display = 'flex';
          audioEl.src = verseObj.audio_link;
          if (audioPlayIcon) audioPlayIcon.textContent = '🔊';
          if (audioPlayText) audioPlayText.textContent = 'Play Sacred Recitation';
        } else {
          audioBar.style.display = 'none';
          audioEl.pause();
        }
      }

      renderTranslations();
      renderCommentaries();
      renderWordBreakdown();
      renderFaqs();
    }

    function renderTranslations() {
      const container = document.getElementById('translationsList');
      if (!container) return;
      const verseObj = currentVersesData[currentVerse - 1];
      if (!verseObj) return;

      const translations = (verseObj.translations && verseObj.translations.length)
        ? verseObj.translations
        : (verseObj.translation ? [{ author_name: 'Traditional Translation', description: verseObj.translation, language: 'English' }] : []);

      if (translations.length === 0) {
        container.innerHTML = '<p class="font-lora" style="color: var(--text-muted); padding: 1rem 0;">No translations indexed for this verse.</p>';
        return;
      }

      container.innerHTML = translations.map(t => `
        <div class="interpretation-card">
          <div class="interpretation-header">
            <span class="author-title">${t.author_name || t.author || 'Traditional Translator'}</span>
            <span class="school-tag">${t.language || 'English'}</span>
          </div>
          <div class="interpretation-body font-lora">
            ${(t.description || t.text || '').replace(/\n/g, '<br/>')}
          </div>
        </div>
      `).join('');
    }

    function renderCommentaries() {
      const container = document.getElementById('commentariesList');
      if (!container) return;
      const verseObj = currentVersesData[currentVerse - 1];
      if (!verseObj) return;

      let commentaries = verseObj.commentaries || [];

      if (activeSchool !== 'all') {
        commentaries = commentaries.filter(c => {
          const author = c.author_name || c.author || '';
          const school = c.school || schoolMap[author] || '';
          const lang = c.language || '';
          return school.toLowerCase().includes(activeSchool.toLowerCase()) || 
                 author.toLowerCase().includes(activeSchool.toLowerCase()) ||
                 lang.toLowerCase().includes(activeSchool.toLowerCase());
        });
      }

      if (commentaries.length === 0) {
        container.innerHTML = `
          <div style="padding: 1.5rem 0; color: var(--text-muted); font-size: 0.9rem;">
            No commentaries found matching filter. Try selecting "All Commentaries".
          </div>
        `;
        return;
      }

      container.innerHTML = commentaries.map(c => {
        const author = c.author_name || c.author || 'Commentator';
        const school = c.school || schoolMap[author] || c.language || 'Traditional';
        const isBhasya = author.includes('Shankara') || author.includes('Shankaracharya') || school.includes('Advaita');
        return `
          <div class="interpretation-card">
            <div class="interpretation-header">
              <span class="author-title">${author}</span>
              <span class="school-tag">${school}</span>
              ${isBhasya ? `<a href="/bhashya-dictionary" target="_blank" class="dict-quick-badge font-cinzel" title="Lookup terms in the 95,585-word Śāṅkara Bhāṣya Lexicon"><span>📖</span> Lexicon</a>` : ''}
            </div>
            <div class="interpretation-body font-lora bhasya-selectable">
              ${(c.description || c.text || '').replace(/\n/g, '<br/>')}
            </div>
          </div>
        `;
      }).join('');
    }

    function renderWordBreakdown() {
      const container = document.getElementById('wordBreakdownContent');
      if (!container) return;
      const verseObj = currentVersesData[currentVerse - 1];
      if (!verseObj) return;

      const words = verseObj.word_by_word;

      if (!words || (Array.isArray(words) && words.length === 0)) {
        container.innerHTML = `
          <p class="font-lora" style="grid-column: 1 / -1; color: var(--text-muted); padding: 1rem 0;">
            Word-by-word grammatical breakdown is not indexed for this sutra. Please refer to translations and commentaries.
          </p>
        `;
        return;
      }

      if (Array.isArray(words)) {
        container.innerHTML = words.map(w => {
          const cleanWord = (w.word_sanskrit || '').replace(/[\s\u0964\u0965\.\,\-\:\;\|\!\?\'\"0-9०-९\(\)]/g, '').trim();
          return `
            <div class="word-card interactive-word-card" data-word="${cleanWord}" tabindex="0" role="button" title="Click to inspect dictionary analysis for ${cleanWord}">
              <div class="word-header-row">
                <div class="word-sanskrit">${w.word_sanskrit || ''}</div>
                <span class="card-lookup-icon" title="On-screen lookup">🔍</span>
              </div>
              <div class="word-meaning font-lora">${(w.word_english || '').replace(/\n/g, '<br/>')}</div>
              ${w.grammar_role ? `<div class="word-grammar">${w.grammar_role} ${w.root ? `• Root: ${w.root}` : ''}</div>` : ''}
            </div>
          `;
        }).join('');
      } else {
        container.innerHTML = `<div class="interpretation-card font-lora">${String(words)}</div>`;
      }
    }

    function renderFaqs() {
      const container = document.getElementById('faqsList');
      const metaOverviewEl = document.getElementById('metadataOverviewCard');
      const verseObj = currentVersesData[currentVerse - 1];
      if (!verseObj) return;

      const meta = verseObj.metadata || {};
      const secTitle = verseObj.section_title || meta.section_title || '';
      const stage = verseObj.sadhana_stage || meta.sadhana_stage || '';
      const doctrine = verseObj.primary_doctrine || meta.primary_doctrine || '';
      const prakriya = verseObj.prakriya_mapped || meta.prakriya_mapped || '';
      const obstacle = verseObj.target_obstacle || meta.target_obstacle || '';
      const category = meta.metaphysical_category || '';
      const srutiEcho = meta.sruti_smriti_echo || '';
      const mahavakya = meta.mahavakya_correlative || '';
      const dialogueCtx = meta.dialogue_context || '';
      const keywords = verseObj.keywords_sanskrit || meta.keywords_sanskrit || [];

      // Render Metadata Overview Card
      if (metaOverviewEl) {
        const gridItems = [];
        if (secTitle) {
          gridItems.push(`
            <div class="meta-item">
              <div class="meta-item-label">Thematic Section</div>
              <div class="meta-item-value" style="color: var(--accent-gold); font-weight: 600;">${secTitle}</div>
            </div>
          `);
        }
        if (doctrine) {
          gridItems.push(`
            <div class="meta-item">
              <div class="meta-item-label">Primary Doctrine</div>
              <div class="meta-item-value">${doctrine}</div>
            </div>
          `);
        }
        if (prakriya && prakriya !== 'None') {
          gridItems.push(`
            <div class="meta-item">
              <div class="meta-item-label">Methodology (Prakriyā)</div>
              <div class="meta-item-value">${prakriya}</div>
            </div>
          `);
        }
        if (stage) {
          gridItems.push(`
            <div class="meta-item">
              <div class="meta-item-label">Sādhana Stage</div>
              <div class="meta-item-value">${stage}</div>
            </div>
          `);
        }
        if (obstacle) {
          gridItems.push(`
            <div class="meta-item">
              <div class="meta-item-label">Dismantles Obstacle</div>
              <div class="meta-item-value" style="color: #f87171;">${obstacle}</div>
            </div>
          `);
        }
        if (category) {
          gridItems.push(`
            <div class="meta-item">
              <div class="meta-item-label">Ontological Sphere</div>
              <div class="meta-item-value">${category}</div>
            </div>
          `);
        }
        if (srutiEcho) {
          gridItems.push(`
            <div class="meta-item" style="grid-column: 1 / -1;">
              <div class="meta-item-label">Śruti / Smṛti Resonance</div>
              <div class="meta-item-value font-lora" style="font-style: italic;">${srutiEcho}</div>
            </div>
          `);
        }
        if (mahavakya) {
          gridItems.push(`
            <div class="meta-item">
              <div class="meta-item-label">Mahāvākya Correlation</div>
              <div class="meta-item-value font-devanagari" style="color: var(--accent-gold);">${mahavakya}</div>
            </div>
          `);
        }
        if (dialogueCtx) {
          gridItems.push(`
            <div class="meta-item">
              <div class="meta-item-label">Teaching Setting</div>
              <div class="meta-item-value">${dialogueCtx}</div>
            </div>
          `);
        }
        if (Array.isArray(keywords) && keywords.length > 0) {
          gridItems.push(`
            <div class="meta-item" style="grid-column: 1 / -1;">
              <div class="meta-item-label">Key Sanskrit Terms</div>
              <div class="meta-item-value" style="display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.25rem;">
                ${keywords.map(kw => `<span class="meta-chip keyword">${kw}</span>`).join('')}
              </div>
            </div>
          `);
        }

        if (gridItems.length > 0) {
          metaOverviewEl.innerHTML = `
            <div class="meta-overview-header font-cinzel">
              Philosophical Framework & Textual Context
            </div>
            <div class="meta-grid">
              ${gridItems.join('')}
            </div>
          `;
          metaOverviewEl.style.display = 'block';
        } else {
