---
import Layout from '../layouts/Layout.astro';
import ScriptureCard from '../components/ScriptureCard.astro';
import { getScripturesByTradition, getScriptureById } from '../data/scriptures';

const yogaScriptures = getScripturesByTradition('yoga');
const yogasutras = getScriptureById('yogasutras')!;
const hyp = getScriptureById('hatha-yoga-pradipika')!;
const gheranda = getScriptureById('gheranda-samhita')!;
const shivasamhita = getScriptureById('shiva-samhita');

const padas = yogasutras.chapters;
const shivaPatalas = shivasamhita?.chapters || [];
const totalYogaChapters = yogaScriptures.reduce((acc, s) => acc + s.chapters_count, 0);
const totalYogaVerses = yogaScriptures.reduce((acc, s) => acc + s.total_verses, 0);

const saptangaLimbs = [
  { name: 'Ṣaṭkarma (शोधन)', desc: 'Purification of the bodily vessel (ghata) via Dhauti, Basti, Neti, Lauliki, Trataka, and Kapalabhati.' },
  { name: 'Āsana (दृढता)', desc: 'Conferring physical stability and strength through the 32 classical postures.' },
  { name: 'Mudrā (स्थिरता)', desc: 'Cultivating energetic firmness and awakening Kundalini through 25 seals and locks.' },
  { name: 'Pratyāhāra (धैर्य)', desc: 'Calming the mind and achieving steady inward fortitude by drawing senses inward.' },
  { name: 'Prāṇāyāma (लाघव)', desc: 'Attaining lightness of being and vital purity through eight Kumbhakas and regulated breath.' },
  { name: 'Dhyāna (प्रत्यक्ष)', desc: 'Direct realization of the inner Self through Sthula, Jyotir, and Sukshma meditation.' },
  { name: 'Samādhi (निर्लिप्त)', desc: 'Supreme unattached liberation where the individual soul merges with the Universal.' }
];

const ashtangaLimbs = [
  { name: 'Yama', sanskrit: 'यम', desc: 'Universal moral restraints: Ahimsā (non-violence), Satya (truthfulness), Asteya (non-stealing), Brahmacarya (moderation), Aparigraha (non-greed).' },
  { name: 'Niyama', sanskrit: 'नियम', desc: 'Internal observances: Śauca (purity), Santoṣa (contentment), Tapas (austerity), Svādhyāya (self-study), Īśvara-praṇidhāna (surrender to the Supreme).' },
  { name: 'Āsana', sanskrit: 'आसन', desc: 'Steadfast, relaxed, and comfortable contemplative posture (Sthira-sukham āsanam).' },
  { name: 'Prāṇāyāma', sanskrit: 'प्राणायाम', desc: 'Conscious mastery and regulation of the subtle vital breath and life-force.' },
  { name: 'Pratyāhāra', sanskrit: 'प्रत्याहार', desc: 'Inward withdrawal of the senses from external attractions, returning attention to the mind-field.' },
  { name: 'Dhāraṇā', sanskrit: 'धारणा', desc: 'One-pointed focus and fixing of consciousness upon a single sacred locus.' },
  { name: 'Dhyāna', sanskrit: 'ध्यान', desc: 'Unbroken, serene, continuous contemplation where awareness flows without interruption.' },
  { name: 'Samādhi', sanskrit: 'समाधि', desc: 'Transcendental absorption wherein subject, object, and the act of meditation dissolve into pure Light.' }
];

const vrittis = [
  { name: 'Pramāṇa', sanskrit: 'प्रमाण', desc: 'Valid cognition arising through direct perception (pratyakṣa), inference (anumāna), and scriptural testimony (āgama).' },
  { name: 'Viparyaya', sanskrit: 'विपर्यय', desc: 'Misconception or erroneous knowledge not grounded in the true form of the real object.' },
  { name: 'Vikalpa', sanskrit: 'विकल्प', desc: 'Conceptualization or verbal delusion based on words devoid of an objective underlying reality.' },
  { name: 'Nidrā', sanskrit: 'निद्रा', desc: 'Deep dreamless sleep, a mental modification supported by the non-existence of conscious contents.' },
  { name: 'Smṛti', sanskrit: 'स्मृति', desc: 'Memory, the retaining and recalling of previously experienced impressions without modification.' }
];

const upcomingTexts = [
  { title: 'Gorakṣa Saṁhitā', sanskrit: 'गोरक्षसंहिता', author: 'Guru Gorakhnāth', desc: 'Foundational classical Nātha treatise on āsana, prāṇāyāma, and the awakening of Kuṇḍalinī energy.' },
  { title: 'Yoga Vāsiṣṭha', sanskrit: 'योगवासिष्ठ', author: 'Maharshi Vālmīki', desc: 'Monumental philosophical discourse from Sage Vasistha to Sri Rama on liberation and cosmic illusion.' }
];
---

<Layout 
  title="Yoga Scriptures - Patañjali Yoga Sūtras, Haṭha Yoga Pradīpikā, Gheraṇḍa Saṁhitā, Śiva Saṁhitā | VedāntVāṇī"
  description="Explore the authoritative Yoga Scriptures: Patañjali Yoga Sūtras, Haṭha Yoga Pradīpikā, Gheraṇḍa Saṁhitā, and Śiva Saṁhitā with authentic Sanskrit shlokas, translations, commentaries, and word breakdown."
>
  <!-- Hero Section -->
  <section class="yoga-hero">
    <div class="container">
      <div class="hero-content text-center">
        <div class="sacred-badge font-cinzel">
          <span>🧘</span> Yoga Darśana • योग शास्त्र
        </div>
        <h1 class="hero-title font-cinzel">
          Yoga Scriptures
        </h1>
        <div class="sanskrit-motto font-devanagari">
          योगश्चित्तवृत्तिनिरोधः • तदा द्रष्टुः स्वरूपेऽवस्थानम्
        </div>
        <p class="hero-tagline font-lora">
          “Yoga is the intentional stilling of the fluctuations of consciousness. Then the Seer rests immutably in its own essential nature.”
          <span class="motto-ref">— Patañjali Yoga Sūtras (1.2 – 1.3)</span>
        </p>

        <!-- Stats Strip -->
        <div class="yoga-stats">
          <div class="stat-box">
            <span class="stat-number font-cinzel">{yogaScriptures.length}</span>
            <span class="stat-label">Canonical Texts</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-box">
            <span class="stat-number font-cinzel">{totalYogaChapters}</span>
            <span class="stat-label">Upadeśas / Paṭalas</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-box">
            <span class="stat-number font-cinzel">{totalYogaVerses}</span>
            <span class="stat-label">Total Verses</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Live Yoga Canonical Library Grid -->
  <section class="live-yoga-section">
    <div class="container">
      <div class="section-title-wrap text-center">
        <h2 class="section-title font-cinzel">Canonical Yoga Library</h2>
        <p class="section-subtitle font-lora">
          Explore complete, unabridged treatises of classical Rāja and Haṭha Yoga with verse-by-verse exegesis.
        </p>
      </div>

      <div class="yoga-cards-grid">
        {yogaScriptures.map((s) => (
          <ScriptureCard scripture={s} showCategory={false} />
        ))}
      </div>
    </div>
  </section>

  <!-- Saptanga Yoga (Gheranda Samhita) -->
  <section class="saptanga-section">
    <div class="container">
      <div class="section-title-wrap text-center">
        <h2 class="section-title font-cinzel">Gheraṇḍa Saṁhitā: The Saptāṅga Yoga</h2>
        <p class="section-subtitle font-lora">The seven-fold vessel-purification (Ghaṭastha Yoga) taught by Sage Gheraṇḍa to King Caṇḍakapāli.</p>
      </div>

      <div class="saptanga-grid">
        {saptangaLimbs.map((limb, idx) => (
          <div class="glass-card saptanga-card">
            <div class="saptanga-num font-cinzel">0{idx + 1}</div>
            <h3 class="saptanga-name font-cinzel">{limb.name}</h3>
            <p class="saptanga-desc font-lora">{limb.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4 Padas of Yoga Sutras -->
  <section class="padas-section" id="padasSection">
    <div class="container">
      <div class="section-title-wrap text-center">
        <h2 class="section-title font-cinzel">The Four Pādas of the Patañjali Yoga Sūtras</h2>
        <p class="section-subtitle font-lora">The philosophical architecture of meditative liberation.</p>
      </div>

      <div class="padas-grid">
        {padas.map((ch) => (
          <div class="glass-card pada-card">
            <div class="pada-card-inner">
              <div class="pada-top-meta">
                <span class="pada-num font-cinzel">Pāda {ch.chapter_number}</span>
                <span class="pada-vcount font-cinzel">{ch.verses_count} Sūtras</span>
              </div>

              <h3 class="pada-title font-cinzel">
                {ch.name}
              </h3>
              {ch.name_sanskrit && (
                <div class="pada-sanskrit font-devanagari">
                  {ch.name_sanskrit} {ch.name_transliterated ? `• ${ch.name_transliterated}` : ''}
                </div>
              )}

              <p class="pada-summary-text font-lora">
                {ch.summary}
              </p>

              <div class="pada-card-action">
                <a href={`/read/yogasutras?c=${ch.chapter_number}&v=1`} class="read-pada-btn font-cinzel">
                  <span>Read Pāda {ch.chapter_number}</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- The 8 Limbs of Ashtanga Yoga -->
  <section class="ashtanga-section">
    <div class="container">
      <div class="section-title-wrap text-center">
        <h2 class="section-title font-cinzel">Aṣṭāṅga Yoga: The Eight Limbs</h2>
        <p class="section-subtitle font-lora">The progressive integral discipline for unveiling the light of discriminative discernment.</p>
      </div>

      <div class="ashtanga-grid">
        {ashtangaLimbs.map((limb, idx) => (
          <div class="glass-card limb-card">
            <div class="limb-index font-cinzel">0{idx + 1}</div>
            <div class="limb-header">
              <h3 class="limb-name font-cinzel">{limb.name}</h3>
              <span class="limb-sanskrit font-devanagari">{limb.sanskrit}</span>
            </div>
            <p class="limb-desc font-lora">{limb.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- The 5 Mental Modifications (Vrittis) -->
  <section class="vrittis-section">
    <div class="container">
      <div class="glass-card vritti-card">
        <h3 class="vritti-title font-cinzel text-center">
          The Five Mental Modifications (Pañca-Vṛttayaḥ)
        </h3>
        <p class="vritti-subtitle font-lora text-center">
          *“वृत्तयः पञ्चतय्यः क्लिष्टाऽक्लिष्टाः”* — The modifications of the mind-field are fivefold, and are either affliction-causing (*kliṣṭa*) or conducive to freedom (*akliṣṭa*):
        </p>

        <div class="vrittis-grid">
          {vrittis.map((vritti, idx) => (
            <div class="vritti-item">
              <span class="vritti-num font-cinzel">0{idx + 1}</span>
              <h4 class="vritti-name font-cinzel">{vritti.name} ({vritti.sanskrit})</h4>
              <p class="vritti-desc font-lora">{vritti.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  <!-- Shiva Samhita Section -->
  <section class="shiva-samhita-section">
    <div class="container">
      <div class="section-title-wrap text-center">
        <div class="sacred-badge font-cinzel">
          <span>🔱</span> Śiva Saṁhitā • पञ्चपटलाः
        </div>
        <h2 class="section-title font-cinzel">Śiva Saṁhitā: The Five Paṭalas</h2>
        <p class="section-subtitle font-lora">
          Lord Shiva's esoteric exposition on Advaitic gnosis, the 350,000 subtle Nāḍīs, vital Vāyus, Kuṇḍalinī Mudrās, and the Ṣaṭ-Cakras.
        </p>
      </div>

      <div class="shiva-patalas-grid">
        {shivaPatalas.map((patala) => (
          <div class="glass-card patala-card">
            <div class="patala-top-meta">
              <span class="patala-num font-cinzel">Paṭala {patala.chapter_number}</span>
              <span class="patala-vcount">{patala.verses_count} Verses</span>
            </div>
            <h3 class="patala-title font-cinzel">{patala.name}</h3>
            {patala.name_sanskrit && (
              <div class="patala-sanskrit font-devanagari">{patala.name_sanskrit}</div>
            )}
            <p class="patala-summary-text font-lora">{patala.summary}</p>
            <div class="patala-card-action">
              <a href={`/read/shiva-samhita?c=${patala.chapter_number}&v=1`} class="read-patala-btn font-cinzel">
                <span>Read Paṭala {patala.chapter_number}</span>
                <span>→</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Upcoming Yoga Scriptures Expansion Library -->
  <section class="expansion-section">
    <div class="container">
      <div class="section-title-wrap text-center">
        <h2 class="section-title font-cinzel">Expanding the Yoga Repository</h2>
        <p class="section-subtitle font-lora">
          VedāntVāṇī is structured to incorporate the full canon of classical Haṭha, Tantra, and Raja Yoga treatises:
        </p>
      </div>

      <div class="upcoming-grid">
        {upcomingTexts.map((text) => (
          <div class="glass-card upcoming-card">
            <div class="upcoming-badge font-cinzel">In Repository Pipeline</div>
            <h3 class="upcoming-title font-cinzel">{text.title}</h3>
            <div class="upcoming-sanskrit font-devanagari">{text.sanskrit}</div>
            <span class="upcoming-author font-cinzel">Attributed to {text.author}</span>
            <p class="upcoming-desc font-lora">{text.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .yoga-hero {
    padding: 3rem 0 2.5rem 0;
    text-align: center;
    position: relative;
  }

  @media (min-width: 768px) {
    .yoga-hero {
      padding: 4.5rem 0 3.5rem 0;
    }
  }

  .text-center {
    text-align: center;
  }

  .hero-content {
    max-width: 820px;
    margin: 0 auto;
  }

  .sacred-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-pill);
    background: var(--saffron-subtle);
    border: 1px solid var(--border-subtle);
    color: var(--saffron);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
  }

  .hero-title {
    font-size: 2.35rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1.2;
    margin-bottom: 0.75rem;
    background: linear-gradient(135deg, var(--text-primary) 30%, var(--gold) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  @media (min-width: 640px) {
    .hero-title {
      font-size: 3.25rem;
    }
  }

  .sanskrit-motto {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--gold);
    margin-bottom: 0.75rem;
    line-height: 1.6;
  }

  @media (min-width: 640px) {
    .sanskrit-motto {
      font-size: 1.35rem;
    }
  }

  .hero-tagline {
    font-size: 1rem;
    font-style: italic;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .motto-ref {
    display: block;
    font-size: 0.8rem;
    font-style: normal;
    color: var(--saffron);
    margin-top: 0.3rem;
  }

  .yoga-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem 1.75rem;
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    max-width: 600px;
    margin: 0 auto;
  }

  .stat-box {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-number {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--saffron);
    line-height: 1.1;
  }

  .stat-label {
    font-size: 0.72rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .stat-divider {
    width: 1px;
    height: 32px;
    background: var(--border-subtle);
    display: none;
  }

  @media (min-width: 640px) {
    .stat-divider {
      display: block;
    }
  }

  /* Live Yoga Grid */
  .live-yoga-section {
    padding: 3rem 0;
  }

  .section-title-wrap {
    margin-bottom: 2.25rem;
  }

  .section-title {
    font-size: 1.65rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.35rem;
  }

  .section-subtitle {
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .yoga-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .yoga-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .yoga-cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Saptanga Section */
  .saptanga-section {
    padding: 3rem 0;
  }

  .saptanga-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .saptanga-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .saptanga-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .saptanga-card {
    padding: 1.5rem;
  }

  .saptanga-num {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--saffron);
    opacity: 0.7;
    margin-bottom: 0.4rem;
  }

  .saptanga-name {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .saptanga-desc {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* Padas Section */
  .padas-section {
    padding: 3rem 0;
  }

  .padas-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .padas-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .padas-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .pada-card {
    padding: 1.5rem;
    height: 100%;
  }

  .pada-card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .pada-top-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .pada-num {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--saffron);
  }

  .pada-vcount {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .pada-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .pada-sanskrit {
    font-size: 0.85rem;
    color: var(--gold);
    margin: 0.25rem 0 0.75rem 0;
  }

  .pada-summary-text {
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    flex: 1;
  }

  .pada-card-action {
    margin-top: auto;
  }

  .read-pada-btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.65rem 1rem;
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: all var(--transition-fast);
  }

  .read-pada-btn:hover {
    background: var(--saffron);
    color: #fff;
    border-color: var(--saffron);
    box-shadow: 0 4px 14px var(--saffron-glow);
  }

  /* Shiva Samhita Section */
  .shiva-samhita-section {
    padding: 3rem 0;
  }

  .shiva-patalas-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .shiva-patalas-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .shiva-patalas-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .patala-card {
    padding: 1.5rem;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .patala-top-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .patala-num {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--gold);
  }

  .patala-vcount {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .patala-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .patala-sanskrit {
    font-size: 0.85rem;
    color: var(--gold);
    margin: 0.25rem 0 0.75rem 0;
  }

  .patala-summary-text {
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    flex: 1;
  }

  .read-patala-btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.65rem 1rem;
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
