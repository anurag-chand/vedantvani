---
import Layout from '../layouts/Layout.astro';
import { getScriptureById } from '../data/scriptures';

const gita = getScriptureById('bhagavad-gita')!;
const chapters = gita.chapters;

const yogas = [
  {
    name: 'Karma Yoga',
    title: 'The Path of Selfless Action',
    sanskrit: 'कर्मयोग',
    chapters: 'Chapters 3 – 5',
    description: 'Performing obligatory duties without craving for their fruits, consecrating every action as a worship of the Supreme.',
    icon: '⚡'
  },
  {
    name: 'Dhyāna Yoga',
    title: 'The Path of Meditation',
    sanskrit: 'ध्यानयोग',
    chapters: 'Chapter 6',
    description: 'Disciplining the mind and senses, withdrawing awareness from ephemeral objects, and resting steadfastly in the Self.',
    icon: '🧘'
  },
  {
    name: 'Bhakti Yoga',
    title: 'The Path of Supreme Devotion',
    sanskrit: 'भक्तियोग',
    chapters: 'Chapters 7 – 12',
    description: 'Total surrender and intimate love towards Bhagavan Sri Krishna, culminating in the awe-inspiring Cosmic Form (Viśvarūpa Darśana).',
    icon: '❤️'
  },
  {
    name: 'Jñāna Yoga',
    title: 'The Path of Discriminative Wisdom',
    sanskrit: 'ज्ञानयोग',
    chapters: 'Chapters 13 – 18',
    description: 'Inquiring into the distinction between Kṣetra (the field) and Kṣetrajña (the knower), piercing the veil of the three Guṇas.',
    icon: '👁️'
  }
];
---

<Layout 
  title="Itihāsas - The Epics & Srimad Bhagavad Gītā | VedāntVāṇī"
  description="Explore the epic discourse of Srimad Bhagavad Gītā across 18 chapters and 701 verses, enriched with 7 translations and 16 commentaries from Advaita, Vishishtadvaita, and Dvaita schools."
>
  <!-- Hero Section -->
  <section class="itihasa-hero">
    <div class="container">
      <div class="hero-content">
        <div class="sacred-badge font-cinzel">
          <span>⚔️</span> Epic Canonical Heritage • इतिहास
        </div>
        <h1 class="hero-title font-cinzel">
          The Itihāsas
        </h1>
        <div class="sanskrit-motto font-devanagari">
          यदा यदा हि धर्मस्य ग्लानिर्भवति भारत । अभ्युत्थानमधर्मस्य तदात्मानं सृजाम्यहम् ॥
        </div>
        <p class="hero-tagline font-lora">
          “Whenever righteousness wanes and unrighteousness runs rampant, O Bhārata, I manifest Myself into the mortal realm.”
          <span class="motto-ref">— Bhagavad Gītā (4.7)</span>
        </p>

        <!-- CTA Buttons -->
        <div class="hero-cta-group">
          <a href="/read/bhagavad-gita" class="btn-primary-glow font-cinzel">
            <span>Explore Bhagavad Gītā Reader</span>
            <span>→</span>
          </a>
          <a href="#chaptersSection" class="btn-secondary font-cinzel">
            <span>View All 18 Chapters</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- The 4 Yogas Grid -->
  <section class="yogas-section">
    <div class="container">
      <div class="section-title-wrap text-center">
        <h2 class="section-title font-cinzel">The Four Yogas of the Gītā</h2>
        <p class="section-subtitle font-lora">A complete roadmap for human transformation and spiritual realization.</p>
      </div>

      <div class="yogas-grid">
        {yogas.map((yoga) => (
          <div class="glass-card yoga-card">
            <div class="yoga-icon">{yoga.icon}</div>
            <div class="yoga-header">
              <h3 class="yoga-name font-cinzel">{yoga.name}</h3>
              <span class="yoga-sanskrit font-devanagari">{yoga.sanskrit}</span>
            </div>
            <span class="yoga-chapters font-cinzel">{yoga.chapters}</span>
            <p class="yoga-desc font-lora">{yoga.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 18 Chapters Directory -->
  <section class="chapters-section" id="chaptersSection">
    <div class="container">
      <div class="section-header-row">
        <div>
          <h2 class="section-title font-cinzel">The 18 Chapters of Srimad Bhagavad Gītā</h2>
          <p class="section-subtitle font-lora">701 verses indexed with comparative translations and 16 theological commentaries.</p>
        </div>
        <div class="filter-count-badge font-cinzel">
          18 Chapters • 701 Verses
        </div>
      </div>

      <div class="chapters-grid">
        {chapters.map((ch) => (
          <div class="glass-card chapter-card">
            <div class="chapter-card-inner">
              <div class="chapter-top-meta">
                <span class="chapter-num font-cinzel">Chapter {ch.chapter_number}</span>
                <span class="chapter-vcount font-cinzel">{ch.verses_count} Verses</span>
              </div>

              <h3 class="chapter-title font-cinzel">
                {ch.name}
              </h3>
              {ch.name_sanskrit && (
                <div class="chapter-sanskrit font-devanagari">
                  {ch.name_sanskrit} {ch.name_transliterated ? `• ${ch.name_transliterated}` : ''}
                </div>
              )}

              <p class="chapter-summary-text font-lora">
                {ch.summary.length > 180 ? ch.summary.slice(0, 177) + '...' : ch.summary}
              </p>

              <div class="chapter-card-action">
                <a href={`/read/bhagavad-gita?c=${ch.chapter_number}&v=1`} class="read-chapter-btn font-cinzel">
                  <span>Read Chapter {ch.chapter_number}</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Multi-Tradition Commentary Showcase -->
  <section class="schools-showcase-section">
    <div class="container">
      <div class="glass-card schools-card">
        <h3 class="schools-card-title font-cinzel text-center">
          Comparative Vedāntic Exegesis
        </h3>
        <p class="schools-card-subtitle font-lora text-center">
          Gitā Jñāna bridges the four primary Vedāntic schools of thought, illuminating how each master unlocks the sacred dialogue:
        </p>

        <div class="schools-grid">
          <div class="school-item">
            <h4 class="school-title font-cinzel">Advaita Vedānta</h4>
            <span class="school-masters">Sri Shankaracharya, Madhusudana Saraswati</span>
            <p class="school-body font-lora">
              Focuses on non-duality. Karma yoga purifies the mind (*Citta-śuddhi*), paving the way for Self-knowledge (*Jñāna*) which directly dispels ignorance and dissolves the illusion of duality.
            </p>
          </div>
          <div class="school-item">
            <h4 class="school-title font-cinzel">Viśiṣṭādvaita</h4>
            <span class="school-masters">Sri Ramanujacharya, Venkatanatha</span>
            <p class="school-body font-lora">
              Emphasizes qualified non-dualism and divine loving devotion (*Bhakti*). The individual self (*Jīva*) and cosmos (*Jagat*) form the body of Supreme Narayana, attained through total surrender (*Śaraṇāgati*).
            </p>
          </div>
          <div class="school-item">
            <h4 class="school-title font-cinzel">Dvaita Vedānta</h4>
            <span class="school-masters">Sri Madhavacharya, Sri Jayatirtha</span>
            <p class="school-body font-lora">
              Maintains an absolute, eternal five-fold difference (*Pañca-bheda*) between the Supreme Lord (*Brahman*), individual souls (*Jīvas*), and matter. Liberation is attained through the uncaused grace of Vishnu.
            </p>
          </div>
          <div class="school-item">
            <h4 class="school-title font-cinzel">Śuddhādvaita</h4>
            <span class="school-masters">Sri Vallabhacharya, Sridhara Swami</span>
            <p class="school-body font-lora">
              Expounds pure non-dualism untainted by Maya. Everything is Brahman in manifested and unmanifested states; spiritual life culminates in spontaneous ecstatic devotion (*Puṣṭi-mārga*).
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .itihasa-hero {
    padding: 3rem 0 2.5rem 0;
    text-align: center;
    position: relative;
  }

  @media (min-width: 768px) {
    .itihasa-hero {
      padding: 4.5rem 0 3.5rem 0;
    }
  }

  .hero-content {
    max-width: 820px;
    margin: 0 auto;
  }

  .sacred-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-pill);
    background: var(--saffron-subtle);
    border: 1px solid var(--border-subtle);
    color: var(--saffron);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
  }

  .hero-title {
    font-size: 2.35rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1.2;
    margin-bottom: 0.75rem;
    background: linear-gradient(135deg, var(--text-primary) 30%, var(--gold) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  @media (min-width: 640px) {
    .hero-title {
      font-size: 3.25rem;
    }
  }

  .sanskrit-motto {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--gold);
    margin-bottom: 0.75rem;
    line-height: 1.6;
  }

  @media (min-width: 640px) {
    .sanskrit-motto {
      font-size: 1.35rem;
    }
  }

  .hero-tagline {
    font-size: 1rem;
    font-style: italic;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .motto-ref {
    display: block;
    font-size: 0.8rem;
    font-style: normal;
    color: var(--saffron);
    margin-top: 0.3rem;
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-primary-glow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.6rem;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, var(--saffron), #fa8231);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    box-shadow: 0 4px 20px var(--saffron-glow);
    transition: all var(--transition-fast);
  }

  .btn-primary-glow:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 25px var(--saffron-glow);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.5rem;
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    transition: all var(--transition-fast);
  }

  .btn-secondary:hover {
    border-color: var(--saffron);
    color: var(--saffron);
  }

  /* Yogas Grid */
  .yogas-section {
    padding: 3.5rem 0;
  }

  .text-center {
    text-align: center;
  }

  .section-title-wrap {
    margin-bottom: 2.25rem;
  }

  .section-title {
    font-size: 1.65rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.35rem;
  }

  .section-subtitle {
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .yogas-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .yogas-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .yogas-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .yoga-card {
    padding: 1.5rem;
  }

  .yoga-icon {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  .yoga-header {
    margin-bottom: 0.35rem;
  }

  .yoga-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .yoga-sanskrit {
    font-size: 0.9rem;
    color: var(--gold);
  }

  .yoga-chapters {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--saffron);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .yoga-desc {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* Chapters Section */
  .chapters-section {
    padding: 2.5rem 0;
  }

  .section-header-row {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 768px) {
    .section-header-row {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .filter-count-badge {
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-pill);
    background: var(--saffron-subtle);
    border: 1px solid var(--border-subtle);
    color: var(--saffron);
    font-size: 0.8rem;
    font-weight: 700;
    white-space: nowrap;
    align-self: flex-start;
  }

  .chapters-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .chapters-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .chapters-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  .chapter-card {
    padding: 1.5rem;
    height: 100%;
  }

  .chapter-card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .chapter-top-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .chapter-num {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--saffron);
  }

  .chapter-vcount {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .chapter-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .chapter-sanskrit {
    font-size: 0.85rem;
    color: var(--gold);
    margin: 0.25rem 0 0.75rem 0;
  }

  .chapter-summary-text {
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    flex: 1;
  }

  .chapter-card-action {
    margin-top: auto;
  }

  .read-chapter-btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.65rem 1rem;
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: all var(--transition-fast);
  }

  .read-chapter-btn:hover {
    background: var(--saffron);
    color: #fff;
    border-color: var(--saffron);
    box-shadow: 0 4px 14px var(--saffron-glow);
  }

  /* Schools Showcase */
  .schools-showcase-section {
    padding: 3rem 0;
  }

  .schools-card {
    padding: 2rem 1.5rem;
  }

  @media (min-width: 640px) {
    .schools-card {
      padding: 2.75rem;
    }
  }

  .schools-card-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--gold);
    margin-bottom: 0.5rem;
  }

  .schools-card-subtitle {
    font-size: 0.95rem;
    color: var(--text-muted);
    max-width: 640px;
    margin: 0 auto 2.5rem auto;
  }

  .schools-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 768px) {
    .schools-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .school-item {
    border-top: 1px dashed var(--border-subtle);
    padding-top: 1.25rem;
  }

  .school-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--saffron);
  }

  .school-masters {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin: 0.2rem 0 0.6rem 0;
  }

  .school-body {
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }
</style>
