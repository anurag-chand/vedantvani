---
import Layout from '../layouts/Layout.astro';
import { getScriptureById, getScripturesByTradition } from '../data/scriptures';

const itihasaScriptures = getScripturesByTradition('itihasa');
const gita = getScriptureById('bhagavad-gita')!;
const ramayana = getScriptureById('adhyatma-ramayana')!;
const chapters = gita.chapters;

const yogas = [
  {
    name: 'Karma Yoga',
    title: 'The Path of Selfless Action',
    sanskrit: 'कर्मयोग',
    chapters: 'Chapters 3 – 5',
    description: 'Performing obligatory duties without craving for their fruits, consecrating every action as a worship of the Supreme.',
    icon: '⚡'
  },
  {
    name: 'Dhyāna Yoga',
    title: 'The Path of Meditation',
    sanskrit: 'ध्यानयोग',
    chapters: 'Chapter 6',
    description: 'Disciplining the mind and senses, withdrawing awareness from ephemeral objects, and resting steadfastly in the Self.',
    icon: '🧘'
  },
  {
    name: 'Bhakti Yoga',
    title: 'The Path of Supreme Devotion',
    sanskrit: 'भक्तियोग',
    chapters: 'Chapters 7 – 12',
    description: 'Total surrender and intimate love towards Bhagavan Sri Krishna, culminating in the awe-inspiring Cosmic Form (Viśvarūpa Darśana).',
    icon: '❤️'
  },
  {
    name: 'Jñāna Yoga',
    title: 'The Path of Discriminative Wisdom',
    sanskrit: 'ज्ञानयोग',
    chapters: 'Chapters 13 – 18',
    description: 'Inquiring into the distinction between Kṣetra (the field) and Kṣetrajña (the knower), piercing the veil of the three Guṇas.',
    icon: '👁️'
  }
];
---

<Layout 
  title="Itihāsas - The Canonical Epics: Bhagavad Gītā & Adhyātma Rāmāyaṇa | VedāntVāṇī"
  description="Explore the monumental epics of Sanātana Dharma: Srimad Bhagavad Gītā (701 verses) and Adhyātma Rāmāyaṇa (4,247 verses, 205 events) with non-dual Advaita realization."
>
  <!-- Hero Section -->
  <section class="itihasa-hero">
    <div class="container">
      <div class="hero-content">
        <div class="sacred-badge font-cinzel">
          <span>⚔️</span> Canonical Epics & Itihāsa • इतिहास
        </div>
        <h1 class="hero-title font-cinzel">
          The Itihāsas
        </h1>
        <div class="sanskrit-motto font-devanagari">
          रामो विग्रहवान् धर्मः • यदा यदा हि धर्मस्य ग्लानिर्भवति भारत
        </div>
        <p class="hero-tagline font-lora">
          The monumental narratives of Sanātana Dharma where cosmic philosophy meets heroic righteousness. Explore both the non-dual revelation of the <strong>Adhyātma Rāmāyaṇa</strong> and the battlefield song of the <strong>Śrīmad Bhagavad Gītā</strong>.
        </p>

        <!-- Stats Strip -->
        <div class="itihasa-stats">
          <div class="stat-box">
            <span class="stat-number font-cinzel">{itihasaScriptures.length}</span>
            <span class="stat-label">Canonical Epics</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-box">
            <span class="stat-number font-cinzel">83</span>
            <span class="stat-label">Kāṇḍas & Chapters</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-box">
            <span class="stat-number font-cinzel">4,948</span>
            <span class="stat-label">Sacred Verses</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-box">
            <span class="stat-number font-cinzel">205</span>
            <span class="stat-label">Advaita Events</span>
          </div>
        </div>

        <!-- CTA Buttons -->
        <div class="hero-cta-group">
          <a href="/adhyatma-ramayana" class="btn-primary-glow font-cinzel">
            <span>Open Adhyātma Rāmāyaṇa</span>
            <span>→</span>
          </a>
          <a href="/read/bhagavad-gita" class="btn-secondary font-cinzel">
            <span>Explore Bhagavad Gītā</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- The Two Monumental Epics Showcase -->
  <section class="epics-portal-section">
    <div class="container">
      <div class="section-title-wrap text-center">
        <h2 class="section-title font-cinzel">The Two Monumental Epics</h2>
        <p class="section-subtitle font-lora">
          Select an epic to immerse in its verse-level wisdom, philosophical discourses, and commentaries.
        </p>
      </div>

      <div class="epics-grid">
        <!-- Adhyatma Ramayana Card -->
        <div class="glass-card epic-showcase-card ramayana-card">
          <div class="epic-badge font-cinzel">
            <span>🏹</span> Brahmāṇḍa Purāṇa • अध्यात्मरामायणम्
          </div>
          <h3 class="epic-title font-cinzel">Adhyātma Rāmāyaṇa</h3>
          <div class="epic-sanskrit font-devanagari">अध्यात्मरामायणम् • श्रीशिवपार्वतीसंवादः</div>
          <p class="epic-desc font-lora">
            The philosophical crest-jewel of the Rāmāyaṇa tradition. Unifying Ramabhakti with unconditioned Advaita Vedānta, Śrī Rāma is revealed as the unconditioned Para Brahman and Sītā as Mūla-Prakṛti / Yoga-Māyā. Featuring the celebrated Rāma Hṛdaya and Śrī Rāma Gītā.
          </p>
          <div class="epic-meta-strip font-cinzel">
            <span>7 Kāṇḍas</span> • <span>65 Sargas</span> • <span>4,247 Verses</span> • <span>205 Event IDs</span>
          </div>
          <div class="epic-card-actions">
            <a href="/adhyatma-ramayana" class="btn-primary-glow font-cinzel full-width-btn">
              <span>Open Adhyātma Rāmāyaṇa Full Page</span>
              <span>→</span>
            </a>
          </div>
        </div>

        <!-- Bhagavad Gita Card -->
        <div class="glass-card epic-showcase-card gita-card">
          <div class="epic-badge font-cinzel">
            <span>⚔️</span> Mahābhārata • श्रीमद्भगवद्गीता
          </div>
          <h3 class="epic-title font-cinzel">Śrīmad Bhagavad Gītā</h3>
          <div class="epic-sanskrit font-devanagari">श्रीमद्भगवद्गीता • श्रीकृष्णार्जुनसंवादः</div>
          <p class="epic-desc font-lora">
            The immortal battlefield dialogue between Bhagavān Śrī Kṛṣṇa and Arjuna. Synthesizes Karma, Bhakti, Dhyāna, and Jñāna Yoga across 18 chapters with 16 multi-lineage commentaries from Advaita, Viśiṣṭādvaita, Dvaita, and Śuddhādvaita schools.
          </p>
          <div class="epic-meta-strip font-cinzel">
            <span>18 Chapters</span> • <span>701 Verses</span> • <span>16 Commentaries</span> • <span>7 Translations</span>
          </div>
          <div class="epic-card-actions">
            <a href="/read/bhagavad-gita" class="btn-primary-glow font-cinzel full-width-btn">
              <span>Explore Bhagavad Gītā Reader</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Adhyatma Ramayana 7 Kandas Section -->
  <section class="kandas-section" id="kandasSection">
    <div class="container">
      <div class="section-header-row">
        <div>
          <div class="sacred-badge font-cinzel" style="margin-bottom: 0.5rem;">
            <span>🏹</span> Adhyātma Rāmāyaṇa Compendium
          </div>
          <h2 class="section-title font-cinzel">The Seven Kāṇḍas (सप्तकाण्डानि)</h2>
          <p class="section-subtitle font-lora">
            Structured at the narrative Event ID level with Advaita ontology, cosmic allegories, word-by-word padaccheda, and review audit tools.
          </p>
        </div>
        <a href="/adhyatma-ramayana" class="filter-count-badge font-cinzel highlight-link" title="Open Full Compendium">
          Open Full Page →
        </a>
      </div>

      <div class="kandas-grid">
        {ramayana.chapters.map((k) => (
          <a href={`/adhyatma-ramayana?k=${k.chapter_number}`} class="kanda-card-link">
            <div class="glass-card kanda-card">
              <div class="kanda-top-meta">
                <span class="kanda-num font-cinzel">Kāṇḍa {k.chapter_number}</span>
                <span class="kanda-vcount font-cinzel">{k.verses_count} Verses</span>
              </div>
              <h3 class="kanda-title font-cinzel">{k.name}</h3>
              <div class="kanda-sanskrit font-devanagari">{k.name_sanskrit}</div>
              <p class="kanda-summary-text font-lora">
                {k.summary}
              </p>
              <div class="kanda-action font-cinzel">
                <span>Open in Compendium</span>
                <span>→</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- The 4 Yogas Grid -->
  <section class="yogas-section">
    <div class="container">
      <div class="section-title-wrap text-center">
        <h2 class="section-title font-cinzel">The Four Yogas of the Gītā</h2>
        <p class="section-subtitle font-lora">A complete roadmap for human transformation and spiritual realization.</p>
      </div>

      <div class="yogas-grid">
        {yogas.map((yoga) => (
          <div class="glass-card yoga-card">
            <div class="yoga-icon">{yoga.icon}</div>
            <div class="yoga-header">
              <h3 class="yoga-name font-cinzel">{yoga.name}</h3>
              <span class="yoga-sanskrit font-devanagari">{yoga.sanskrit}</span>
            </div>
            <span class="yoga-chapters font-cinzel">{yoga.chapters}</span>
            <p class="yoga-desc font-lora">{yoga.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 18 Chapters Directory -->
  <section class="chapters-section" id="chaptersSection">
    <div class="container">
      <div class="section-header-row">
        <div>
          <h2 class="section-title font-cinzel">The 18 Chapters of Srimad Bhagavad Gītā</h2>
          <p class="section-subtitle font-lora">701 verses indexed with comparative translations and 16 theological commentaries.</p>
        </div>
        <div class="filter-count-badge font-cinzel">
          18 Chapters • 701 Verses
        </div>
      </div>

      <div class="chapters-grid">
        {chapters.map((ch) => (
          <div class="glass-card chapter-card">
            <div class="chapter-card-inner">
              <div class="chapter-top-meta">
                <span class="chapter-num font-cinzel">Chapter {ch.chapter_number}</span>
                <span class="chapter-vcount font-cinzel">{ch.verses_count} Verses</span>
              </div>

              <h3 class="chapter-title font-cinzel">
                {ch.name}
              </h3>
              {ch.name_sanskrit && (
                <div class="chapter-sanskrit font-devanagari">
                  {ch.name_sanskrit} {ch.name_transliterated ? `• ${ch.name_transliterated}` : ''}
                </div>
              )}

              <p class="chapter-summary-text font-lora">
                {ch.summary.length > 180 ? ch.summary.slice(0, 177) + '...' : ch.summary}
              </p>

              <div class="chapter-card-action">
                <a href={`/read/bhagavad-gita?c=${ch.chapter_number}&v=1`} class="read-chapter-btn font-cinzel">
                  <span>Read Chapter {ch.chapter_number}</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Multi-Tradition Commentary Showcase -->
  <section class="schools-showcase-section">
    <div class="container">
      <div class="glass-card schools-card">
        <h3 class="schools-card-title font-cinzel text-center">
          Comparative Vedāntic Exegesis
        </h3>
        <p class="schools-card-subtitle font-lora text-center">
          Gitā Jñāna bridges the four primary Vedāntic schools of thought, illuminating how each master unlocks the sacred dialogue:
        </p>

        <div class="schools-grid">
          <div class="school-item">
            <h4 class="school-title font-cinzel">Advaita Vedānta</h4>
            <span class="school-masters">Sri Shankaracharya, Madhusudana Saraswati</span>
            <p class="school-body font-lora">
              Focuses on non-duality. Karma yoga purifies the mind (*Citta-śuddhi*), paving the way for Self-knowledge (*Jñāna*) which directly dispels ignorance and dissolves the illusion of duality.
            </p>
          </div>
          <div class="school-item">
            <h4 class="school-title font-cinzel">Viśiṣṭādvaita</h4>
            <span class="school-masters">Sri Ramanujacharya, Venkatanatha</span>
            <p class="school-body font-lora">
              Emphasizes qualified non-dualism and divine loving devotion (*Bhakti*). The individual self (*Jīva*) and cosmos (*Jagat*) form the body of Supreme Narayana, attained through total surrender (*Śaraṇāgati*).
            </p>
          </div>
          <div class="school-item">
            <h4 class="school-title font-cinzel">Dvaita Vedānta</h4>
            <span class="school-masters">Sri Madhavacharya, Sri Jayatirtha</span>
            <p class="school-body font-lora">
              Maintains an absolute, eternal five-fold difference (*Pañca-bheda*) between the Supreme Lord (*Brahman*), individual souls (*Jīvas*), and matter. Liberation is attained through the uncaused grace of Vishnu.
            </p>
          </div>
          <div class="school-item">
            <h4 class="school-title font-cinzel">Śuddhādvaita</h4>
            <span class="school-masters">Sri Vallabhacharya, Sridhara Swami</span>
            <p class="school-body font-lora">
              Expounds pure non-dualism untainted by Maya. Everything is Brahman in manifested and unmanifested states; spiritual life culminates in spontaneous ecstatic devotion (*Puṣṭi-mārga*).
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .itihasa-hero {
    padding: 3rem 0 2.5rem 0;
    text-align: center;
    position: relative;
  }

  @media (min-width: 768px) {
    .itihasa-hero {
      padding: 4.5rem 0 3.5rem 0;
    }
  }

  .hero-content {
    max-width: 820px;
    margin: 0 auto;
  }

  .sacred-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-pill);
    background: var(--saffron-subtle);
    border: 1px solid var(--border-subtle);
    color: var(--saffron);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
  }

  .hero-title {
    font-size: 2.35rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1.2;
    margin-bottom: 0.75rem;
    background: linear-gradient(135deg, var(--text-primary) 30%, var(--gold) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  @media (min-width: 640px) {
    .hero-title {
      font-size: 3.25rem;
    }
  }

  .sanskrit-motto {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--gold);
    margin-bottom: 0.75rem;
    line-height: 1.6;
  }

  @media (min-width: 640px) {
    .sanskrit-motto {
      font-size: 1.35rem;
    }
  }

  .hero-tagline {
    font-size: 1rem;
    font-style: italic;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  /* Stats Strip */
  .itihasa-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    margin-bottom: 2rem;
  }

  .stat-box {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-number {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--saffron);
    line-height: 1.1;
  }

  .stat-label {
    font-size: 0.72rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .stat-divider {
    width: 1px;
    height: 32px;
    background: var(--border-subtle);
    display: none;
  }

  @media (min-width: 640px) {
    .stat-divider {
      display: block;
    }
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Two Monumental Epics Grid */
  .epics-portal-section {
    padding: 3.5rem 0 2rem 0;
  }

  .epics-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: 2rem;
  }

  @media (min-width: 860px) {
    .epics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .epic-showcase-card {
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    transition: transform var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
    position: relative;
    overflow: hidden;
  }

  .epic-showcase-card:hover {
    transform: translateY(-4px);
    border-color: var(--saffron);
    box-shadow: 0 12px 35px rgba(242, 111, 34, 0.15);
  }

  .ramayana-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #f26f22, #e5a93b);
  }

  .gita-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #d4af37, #f26f22);
  }

  .epic-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--saffron);
    margin-bottom: 0.85rem;
  }

  .epic-title {
    font-size: 1.85rem;
    font-weight: 700;
    color: var(--gold);
    line-height: 1.2;
    margin-bottom: 0.35rem;
  }

  .epic-sanskrit {
    font-size: 1rem;
    color: var(--saffron);
    margin-bottom: 1rem;
  }

  .epic-desc {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .epic-meta-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    padding: 0.75rem 0;
    border-top: 1px dashed var(--border-subtle);
    border-bottom: 1px dashed var(--border-subtle);
    margin-bottom: 1.5rem;
  }

  .epic-meta-strip span {
    color: var(--text-primary);
  }

  .full-width-btn {
    width: 100%;
    justify-content: center;
    text-align: center;
  }

  /* Kandas Grid Section */
  .kandas-section {
    padding: 3rem 0;
  }

  .highlight-link {
    background: var(--saffron-subtle);
    color: var(--saffron);
    border: 1px solid var(--border-active);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .highlight-link:hover {
    background: var(--saffron);
    color: #fff;
  }

  .kandas-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-top: 1.75rem;
  }

  @media (min-width: 640px) {
    .kandas-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .kandas-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .kanda-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
    height: 100%;
  }

  .kanda-card {
    padding: 1.4rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    transition: all var(--transition-fast);
  }

  .kanda-card-link:hover .kanda-card {
    transform: translateY(-3px);
    border-color: var(--saffron);
    box-shadow: 0 8px 24px rgba(242, 111, 34, 0.12);
  }

  .kanda-top-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .kanda-num {
    color: var(--saffron);
  }

  .kanda-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--gold);
    margin-bottom: 0.2rem;
  }

  .kanda-sanskrit {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
  }

  .kanda-summary-text {
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--text-muted);
    margin-bottom: 1.2rem;
    flex: 1;
  }

  .kanda-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--saffron);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-top: 1px dashed var(--border-subtle);
    padding-top: 0.75rem;
  }

  .btn-primary-glow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.6rem;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, var(--saffron), #fa8231);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    box-shadow: 0 4px 20px var(--saffron-glow);
    transition: all var(--transition-fast);
  }

  .btn-primary-glow:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 25px var(--saffron-glow);
  }

